<Project Sdk="Microsoft.NET.Sdk">

  <!--
    pcl-next：基于 PCL2 的第三方分支，目标运行时 .NET 10（net10.0-windows）。
    本工程与同目录下遗留的 “Plain Craft Launcher 2.vbproj”（net48，非 SDK 风格）并存，
    源码完全共用；两者互不覆盖（SDK 工程输出到 bin-net10）。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PCL</RootNamespace>
    <AssemblyName>pcl-next</AssemblyName>
    <!-- 不再使用 VB 的 My 命名空间（My.Computer 等由 Modules/Base/MyCompat.vb 补齐） -->
    <MyType>Empty</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
    <!-- 不使用面向 .NET Framework 的 App.config（其中的 system.net 段在 net10 上会直接报错） -->
    <AppConfig>App.net10.config</AppConfig>
    <OutputPath>bin-net10\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>false</DefineTrace>
    <DefineConstants>SNAPSHOT</DefineConstants>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 沿用原工程的 VB 警告豁免 -->
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314,BC40000,BC42024,BC42030,BC42104,BC42353</NoWarn>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DefineConstants>RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Snapshot'">
    <Optimize>true</Optimize>
    <DefineConstants>SNAPSHOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- My.Settings 在本分支未被使用，排除其设计器代码（依赖 System.Configuration 的旧模型） -->
    <Compile Remove="My Project\Settings.Designer.vb" />
    <Compile Remove="My Project\MyExtensions\MyWpfExtension.vb" />
    <!-- 这是供用户替换主页的外观模板，不是页面，原工程也仅作为 None 保留 -->
    <Page Remove="Resources\Custom.xaml" />
    <!-- 上游遗留的死代码：原工程从未编译过该控件（MySlider 才是现役实现） -->
    <Compile Remove="Controls\MySliderDot.xaml.vb" />
    <Page Remove="Controls\MySliderDot.xaml" />
    <None Remove="Images\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与原工程一致的工程级 Imports（VB 的 Import 项） -->
    <Import Include="MeloongCore" />
    <Import Include="MeloongCore.Extensions" />
    <Import Include="MeloongCore.Wpf" />
    <Import Include="MeloongCore.Wpf.Extensions" />
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="Newtonsoft.Json" />
    <Import Include="Newtonsoft.Json.Linq" />
    <Import Include="PCLCS" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.IO.Compression" />
    <Import Include="System.Linq" />
    <Import Include="System.Net" />
    <Import Include="System.Net.Http" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Xml.Linq" />
    <Import Include="ThrottleDebounce" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图片全部作为 WPF 资源打包（原工程逐个列出，这里改为通配） -->
    <Resource Include="Images\**\*.*" />
    <Resource Include="Resources\Font.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- 资源基名必须与 Resources.Designer.vb 中的 "PCL.Resources" 一致 -->
    <EmbeddedResource Update="My Project\Resources.resx">
      <LogicalName>PCL.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
      第三方依赖统一走 NuGet。
      原先是从 Resources.resx 内嵌 + AppDomain.AssemblyResolve 动态加载 net45 程序集，
      在 .NET 10 上已无必要，且会与依赖解析、单文件发布冲突。
      注：Ookii.Dialogs.Wpf 经核查无任何代码引用，已直接移除；
          ThrottleDebounce 的 Retrier 仍在 ModNet / ModBase / ClipboardInterceptor 使用，必须保留。
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="CacheCow.Client" Version="2.13.1" />
    <PackageReference Include="CacheCow.Client.FileStore" Version="2.13.1" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Imazen.WebP" Version="11.0.0" />
    <PackageReference Include="ThrottleDebounce" Version="2.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" />
    <ProjectReference Include="..\MeloongCore\Wpf\MeloongCore.Wpf.csproj" />
    <ProjectReference Include="..\PCLCS\PCLCS.csproj" />
  </ItemGroup>

</Project>
