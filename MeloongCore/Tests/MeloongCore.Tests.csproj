<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 必须是 net10.0-windows：被测的 MeloongCore 是 net10.0、MeloongCore.Wpf 是 net10.0-windows。
		     原值 net48 与 net10.0 工程不兼容（NU1201），整套测试根本编译不起来（2026-11-11 修正）。 -->
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Deterministic>true</Deterministic>
		<IsPackable>false</IsPackable>
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- TUnit 走 Microsoft.Testing.Platform。.NET 10 SDK 的 dotnet test 默认仍是 VSTest，
		     需要本目录的 dotnet.config 指定 runner 才认。
		     因为 dotnet.config 按「当前工作目录向上查找」，运行方式为：
		         cd MeloongCore/Tests && dotnet test -c Release -r win-x64
		     这样只影响本目录，不波及仓库根仍用 xunit/VSTest 的 PCL.Download.Tests。 -->
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="TestFiles\FileUtils\Corrupted.zip" />
	  <None Remove="TestFiles\FileUtils\GB Encoding.zip" />
	  <None Remove="TestFiles\FileUtils\GZ.gz" />
	  <None Remove="TestFiles\FileUtils\Gzip.gz" />
	  <None Remove="TestFiles\FileUtils\Not zip.zip" />
	  <None Remove="TestFiles\FileUtils\UTF8 Encoding.zip" />
	  <None Remove="TestFiles\FileUtils\DotDot ZipSlip.zip" />
	  <None Remove="TestFiles\FileUtils\AbsPath ZipSlip.zip" />
	</ItemGroup>

	<ItemGroup>
		<!-- 不再引用 System.IO.Compression 4.3.0：.NET 10 已内置该程序集，
		     引这个 netstandard1.x 老包只会产生 NU1701 兼容性警告。 -->
		<PackageReference Include="TUnit" Version="1.43.38" />
		<PackageReference Include="PolySharp" Version="1.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="TestFiles\FileUtils\Corrupted.zip">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="TestFiles\FileUtils\GB Encoding.zip">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="TestFiles\FileUtils\GZ.gz">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="TestFiles\FileUtils\UTF8 Encoding.zip">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="TestFiles\FileUtils\Not zip.zip">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="TestFiles\FileUtils\DotDot ZipSlip.zip">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="TestFiles\FileUtils\AbsPath ZipSlip.zip">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.Collections" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.Collections.Concurrent" />
		<Using Include="System.Text" />
		<!-- UseWPF 会把隐式 using 换成 WPF 那一套，默认不再包含 System.IO；
		     测试里大量用 Path/File/Directory，必须显式补上。 -->
		<Using Include="System.IO" />
		<Using Include="System.Net" />
		<Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
		<Using Include="MeloongCore" />
		<Using Include="MeloongCore.Extensions" />
		<Using Include="MeloongCore.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Shared\MeloongCore.csproj" />
		<ProjectReference Include="..\Wpf\MeloongCore.Wpf.csproj" />
	</ItemGroup>

</Project>
