# 本目录的测试工程用 TUnit（Microsoft.Testing.Platform）。
# .NET 10 SDK 的 dotnet test 默认仍走 VSTest，会直接报
# 「Testing with VSTest target is no longer supported by Microsoft.Testing.Platform」。
# dotnet.config 按「当前工作目录向上查找」生效，所以：
#   cd MeloongCore/Tests && dotnet test -c Release -r win-x64
# 只影响本目录，不会波及仓库根仍在使用 xunit/VSTest 的 PCL.Download.Tests。
[dotnet.test.runner]
name = "Microsoft.Testing.Platform"
