<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageLinkMain"
    d:DesignWidth="800" d:DesignHeight="800"
    PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PanMain">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏（与设置页左栏同款 MyListItem 单选） -->
            <StackPanel x:Name="PanNav" Grid.Column="0" Margin="0,10,0,8">
                <TextBlock Text="联机大厅" FontSize="12" Opacity="0.6" Margin="16,6,5,3" />
                <local:MyListItem x:Name="ItemCreate" IsScaleAnimationEnabled="False" Tag="0" MinPaddingRight="10"
                                  Height="36" VerticalAlignment="Top" Title="创建大厅" Type="RadioBox" FontSize="13"
                                  LogoScale="1" Logo="lucide:play" Checked="True" />
                <local:MyListItem x:Name="ItemJoin" IsScaleAnimationEnabled="False" Tag="1" MinPaddingRight="10"
                                  Height="36" VerticalAlignment="Top" Title="加入大厅" Type="RadioBox" FontSize="13"
                                  LogoScale="1" Logo="lucide:bubbles" />
                <local:MyListItem x:Name="ItemRoom" IsScaleAnimationEnabled="False" Tag="2" MinPaddingRight="10"
                                  Height="36" VerticalAlignment="Top" Title="当前房间" Type="RadioBox" FontSize="13"
                                  LogoScale="1" Logo="lucide:users" Visibility="Collapsed" />
                <local:MyListItem x:Name="ItemAbout" IsScaleAnimationEnabled="False" Tag="3" MinPaddingRight="10"
                                  Height="36" VerticalAlignment="Top" Title="关于联机" Type="RadioBox" FontSize="13"
                                  LogoScale="1" Logo="lucide:user" />
                <TextBlock Text="高级" FontSize="12" Opacity="0.6" Margin="16,12,5,3" />
                <local:MyListItem x:Name="ItemSettings" IsScaleAnimationEnabled="False" Tag="4" MinPaddingRight="10"
                                  Height="36" VerticalAlignment="Top" Title="联机设置" Type="RadioBox" FontSize="13"
                                  LogoScale="1" Logo="lucide:sliders" />
            </StackPanel>

            <!-- 右侧内容区：五个面板随导航切换 -->
            <Grid Grid.Column="1" Margin="14,10,16,10">

                <!-- 创建大厅 -->
                <StackPanel x:Name="PanCreate">
                    <local:MyCard x:Name="CardCreate" Margin="0,0,0,15" Title="创建大厅">
                        <StackPanel Margin="25,38,25,20">

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                        Background="{DynamicResource ColorBrush7}">
                                    <TextBlock Text="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush2}" />
                                </Border>
                                <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="进入世界后，在游戏菜单中选择【对局域网开放】，记下聊天栏里的端口号" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                        Background="{DynamicResource ColorBrush7}">
                                    <TextBlock Text="2" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush2}" />
                                </Border>
                                <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="在下方填写该端口，单击【创建】" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                        Background="{DynamicResource ColorBrush7}">
                                    <TextBlock Text="3" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush2}" />
                                </Border>
                                <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="创建成功后，复制邀请码发送给你的朋友" />
                            </Grid>

                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextHostPort" FontFamily="Consolas" VerticalAlignment="Center" MaxHeight="28" Text="25565"
                                                 HintText="房主本机 Minecraft 服务器的端口，默认 25565" />
                                <local:MyButton x:Name="BtnResetPort" Grid.Column="1" MinWidth="70" Margin="10,0,0,0" Padding="13,0" Text="默认" />
                                <local:MyButton x:Name="BtnCreate" Grid.Column="2" MinWidth="80" Margin="8,0,0,0" Padding="13,0"
                                                Text="创建" ColorType="Highlight" />
                            </Grid>
                            <Grid x:Name="PanCode" Visibility="Collapsed" Height="35" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextCode" FontFamily="Consolas" VerticalAlignment="Center" MaxHeight="28" IsReadOnly="True" />
                                <local:MyButton x:Name="BtnCopyCode" Grid.Column="1" MinWidth="90" Margin="10,0,0,0" Padding="13,0" Text="复制邀请码" />
                            </Grid>
                            <Grid x:Name="PanDirect" Visibility="Collapsed" Height="35" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextDirectShow" FontFamily="Consolas" VerticalAlignment="Center" MaxHeight="28" IsReadOnly="True"
                                                 ToolTip="公共中转节点不可用时，好友可凭这条地址直连你" />
                                <local:MyButton x:Name="BtnCopyDirect" Grid.Column="1" MinWidth="90" Margin="10,0,0,0" Padding="13,0" Text="复制地址" />
                            </Grid>
                        </StackPanel>
                    </local:MyCard>
                </StackPanel>

                <!-- 加入大厅 -->
                <StackPanel x:Name="PanJoin" Visibility="Collapsed">
                    <local:MyCard x:Name="CardJoin" Margin="0,0,0,15" Title="加入大厅">
                        <StackPanel Margin="25,38,25,20">

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                        Background="{DynamicResource ColorBrush7}">
                                    <TextBlock Text="1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush2}" />
                                </Border>
                                <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="在下方输入朋友发送给你的邀请码，单击【加入】" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                        Background="{DynamicResource ColorBrush7}">
                                    <TextBlock Text="2" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush2}" />
                                </Border>
                                <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Text="启动游戏，选择【多人游戏】，在局域网游戏中加入大厅" />
                            </Grid>

                            <Grid Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextJoinCode" FontFamily="Consolas" VerticalAlignment="Center" MaxHeight="28"
                                                 HintText="pcl-next 短码、PCL2-CE 的 U/XXXX-XXXX-XXXX-XXXX、陶瓦码，自动识别" />
                                <local:MyButton x:Name="BtnClear" Grid.Column="1" MinWidth="70" Margin="10,0,0,0" Padding="13,0" Text="清除" />
                                <local:MyButton x:Name="BtnPaste" Grid.Column="2" MinWidth="70" Margin="8,0,0,0" Padding="13,0" Text="粘贴" />
                                <local:MyButton x:Name="BtnJoin" Grid.Column="3" MinWidth="80" Margin="8,0,0,0" Padding="13,0"
                                                Text="加入" ColorType="Highlight" />
                            </Grid>
                            <Grid Margin="0,10,0,0" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LinkName" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="直连地址" Margin="0,0,15,0" Opacity="0.85"
                                           ToolTip="可选。公共中转节点连不上时，填房主给出的 IP:端口" />
                                <local:MyTextBox x:Name="TextDirect" Grid.Column="1" FontFamily="Consolas" VerticalAlignment="Center" MaxHeight="28"
                                                 HintText="可选，公共节点连不上时填房主的 IP:端口（U/ 码不用填）" />
                            </Grid>
                            <TextBlock x:Name="LabJoinTip" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </local:MyCard>
                </StackPanel>

                <!-- 当前房间（进房后替代创建 / 加入卡片；结构对齐 PCL2-CE 的大厅信息 + 操作 + 成员） -->
                <StackPanel x:Name="PanRoom" Visibility="Collapsed">

                    <!-- 大厅信息卡：状态 + 房主 + 延迟 + 房间号 + 邀请码 -->
                    <local:MyCard x:Name="CardRoom" Margin="0,0,0,15" Title="房间信息">
                        <StackPanel Margin="25,38,25,20">

                            <Border CornerRadius="8" Background="{DynamicResource ColorBrush8}" Margin="0,0,0,14">
                                <Grid Margin="16,12,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="DotStatus" Width="9" Height="9" VerticalAlignment="Center" Margin="2,0,12,0"
                                             Fill="{DynamicResource ColorBrush1}" />
                                    <TextBlock x:Name="LabStatus" Grid.Column="1" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Text="未连接" />
                                    <local:MyButton x:Name="BtnLeave" Grid.Column="2" MinWidth="90" Margin="12,0,0,0" Padding="13,0"
                                                    Text="退出房间" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="房主" Opacity="0.85" />
                                <TextBlock x:Name="LabRoomHost" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Text="—" />
                                <TextBlock x:Name="LabRoomRole" Grid.Column="2" FontSize="12" Opacity="0.65"
                                           VerticalAlignment="Center" Text="" />
                            </Grid>

                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="房主 ID" Opacity="0.85"
                                           ToolTip="房主的启动器机器识别码，换机或重装后会变" />
                                <local:MyTextBox x:Name="TextRoomHostId" Grid.Column="1" FontFamily="Consolas"
                                                 VerticalAlignment="Center" MaxHeight="28" IsReadOnly="True"
                                                 ToolTip="房主的启动器机器识别码，换机或重装后会变" />
                                <local:MyButton x:Name="BtnCopyHostId" Grid.Column="2" MinWidth="60" Margin="10,0,0,0" Padding="10,0"
                                                Text="复制" />
                            </Grid>

                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="延迟" Opacity="0.85"
                                           ToolTip="房主侧按 EasyTier 对等连接实测；加入侧是本机到房主的协议往返" />
                                <TextBlock x:Name="LabRoomPing" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                                           Text="—" />
                            </Grid>

                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="房间号" Opacity="0.85"
                                           ToolTip="由邀请码派生的 6 位短号，双方算出同一个，便于口头核对" />
                                <TextBlock x:Name="LabRoomNumber" Grid.Column="1" FontSize="13" FontFamily="Consolas"
                                           VerticalAlignment="Center" Text="—" />
                                <TextBlock Grid.Column="2" FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                           Text="仅用于口头核对" />
                            </Grid>

                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="邀请码" Opacity="0.85" />
                                <local:MyTextBox x:Name="TextRoomCode" Grid.Column="1" FontFamily="Consolas"
                                                 VerticalAlignment="Center" MaxHeight="28" IsReadOnly="True" />
                                <local:MyButton x:Name="BtnCopyRoomCode" Grid.Column="2" MinWidth="70" Margin="10,0,0,0" Padding="10,0"
                                                Text="复制邀请码" />
                            </Grid>

                            <Grid x:Name="PanRoomAddress" Height="34" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="游戏内地址" Opacity="0.85"
                                           ToolTip="在 Minecraft 的多人游戏里直接连接这条地址" />
                                <local:MyTextBox x:Name="TextRoomAddress" Grid.Column="1" FontFamily="Consolas"
                                                 VerticalAlignment="Center" MaxHeight="28" IsReadOnly="True" />
                                <local:MyButton x:Name="BtnCopyRoomAddress" Grid.Column="2" MinWidth="60" Margin="10,0,0,0" Padding="10,0"
                                                Text="复制" />
                            </Grid>
                        </StackPanel>
                    </local:MyCard>

                    <!-- 成员卡：房主可把成员踢出房间 -->
                    <local:MyCard x:Name="CardRoomPlayers" Margin="0,0,0,15" Title="房间成员">
                        <StackPanel Margin="0,26,0,14">
                            <ItemsControl x:Name="ListPlayers" Margin="8,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Margin="17,0,17,6" Padding="10,6"
                                                Background="{DynamicResource ColorBrush8}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding Detail}">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Sub}" FontSize="11" Opacity="0.62" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding PingText}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                <local:MyButton Grid.Column="2" Text="踢出" MinWidth="60" Height="28"
                                                                Margin="12,0,0,0" Padding="10,0"
                                                                Tag="{Binding MachineId}"
                                                                Visibility="{Binding KickVisibility}"
                                                                Click="BtnKick_Click"
                                                                ToolTip="把该成员移出房间：pcl-next 加入端会自动退出房间；PCL2-CE 加入端只会把它当作心跳失败。已经建立好的游戏连接不会立刻断开（游戏流量走 EasyTier 端口转发，不经过协议服务）。" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="LabPlayersEmpty" Margin="25,4,25,6" FontSize="12" Opacity="0.65"
                                       TextWrapping="Wrap"
                                       Text="还没有拿到成员信息：接入协议（PCL2-CE 大厅）时每 5 秒刷新一次；其它大厅类型不提供成员列表。" />
                        </StackPanel>
                    </local:MyCard>

                </StackPanel>

                <!-- 关于联机 -->
                <StackPanel x:Name="PanAbout" Visibility="Collapsed">
                    <local:MyCard Margin="0,0,0,10" Title="关于联机">
                        <Border Margin="25,30,25,22" CornerRadius="8" Background="{DynamicResource ColorBrush7}">
                            <StackPanel Margin="16,14,16,14">
                                <TextBlock FontSize="12" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Text="本功能由 pcl-next 自行实现，网络层使用 EasyTier 公共节点，不依赖第三方账号或大厅服务。" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <TextBlock FontSize="12" Opacity="0.7" Text="友情链接：" />
                                    <TextBlock x:Name="LinkEasyTier" FontSize="12" Text="EasyTier 工具官网" Cursor="Hand"
                                               Foreground="{DynamicResource ColorBrush1}" />
                                    <TextBlock FontSize="12" Opacity="0.7" Text=" | " />
                                    <TextBlock x:Name="LinkDocs" FontSize="12" Text="联机方案说明" Cursor="Hand"
                                               Foreground="{DynamicResource ColorBrush1}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </local:MyCard>
                </StackPanel>

                <!-- 联机设置（设置项对齐 PCL2-CE 的 EasyTier 卡片） -->
                <StackPanel x:Name="PanSettings" Visibility="Collapsed">
                    <local:MyCard Margin="0,0,0,15" Title="联机设置">
                        <StackPanel Margin="25,38,25,20">

                            <local:MyHint Theme="Blue" Margin="0,0,0,14"
                                          Text="以下设置会在下一次创建或加入大厅时生效；正在联机时修改不会影响当前房间。" />

                            <Grid Margin="0,0,0,10" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="显示名" Opacity="0.85"
                                           ToolTip="在联机网络中标识本机，便于在连接列表里认出自己" />
                                <local:MyTextBox x:Name="TextNick" Grid.Column="1" VerticalAlignment="Center" MaxHeight="28"
                                                 HintText="留空则使用默认名"
                                                 ToolTip="留空时自动使用 Server-xxxx / Client-xxxx，其中 xxxx 由本机标识推导。互通目标为 PCL2-CE 时，房主的网络主机名固定为 scaffolding-mc-server-端口（对方靠它取端口），这里填的名字只作用于大厅玩家列表" />
                            </Grid>

                            <Grid Margin="0,0,0,10" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="互通目标" Opacity="0.85"
                                           ToolTip="决定建房时生成的邀请码格式，以及按哪套参数与其它启动器建立联机网络" />
                                <local:MyComboBox x:Name="ComboInterop" Grid.Column="1" VerticalAlignment="Center" MaxHeight="28"
                                                  ToolTip="选 PCL2-CE / 陶瓦 时，邀请码格式、加密算法、压缩与覆盖地址都会自动换成对方那一套">
                                    <local:MyComboBoxItem Content="仅 pcl-next（不与其他启动器互通）" />
                                    <local:MyComboBoxItem Content="PCL2-CE 大厅（U/ 码）" />
                                    <local:MyComboBoxItem Content="陶瓦（Terracotta）" />
                                </local:MyComboBox>
                            </Grid>

                            <local:MyHint Theme="Yellow" Margin="0,0,0,14"
                                          Text="加入时各类邀请码都会自动识别（pcl-next 短码、PCL2-CE 的 U/XXXX-XXXX-XXXX-XXXX、陶瓦码、PCL2-CE 旧数字码）。选 PCL2-CE 后，本机建房生成的也是同构的 U/ 码：码里只有网名与密钥，服务器端口由双方的 Scaffolding 协议自动协商，所以加入的一方不用再手填端口。对方大厅是自托管协议、没有中心服务，同一张 U/ 码我们建房、对方加入，或对方建房、我们加入，都能走通。" />

                            <Grid Margin="0,0,0,10" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="协议偏好" Opacity="0.85"
                                           ToolTip="连接对等节点时优先使用的传输协议" />
                                <local:MyComboBox x:Name="ComboProtocol" Grid.Column="1" VerticalAlignment="Center" MaxHeight="28"
                                                  ToolTip="TCP 更稳定；UDP 在部分 NAT 环境下穿透更积极">
                                    <local:MyComboBoxItem Content="TCP（更稳定）" />
                                    <local:MyComboBoxItem Content="UDP（穿透更积极）" />
                                </local:MyComboBox>
                            </Grid>

                            <local:MyCheckBox x:Name="CheckLatency" Height="22" Margin="-1,0,0,8" Text="低延迟优先"
                                              ToolTip="优先选择延迟最低的路径，而不是带宽最大的路径（latency-first）" />
                            <local:MyCheckBox x:Name="CheckPunch" Height="22" Margin="-1,0,0,8" Text="允许系统进行端口打洞"
                                              ToolTip="取消勾选后统一走中继（disable-sys-hole-punching）。对称 NAT 下打洞容易失败时，可以试着关掉" />
