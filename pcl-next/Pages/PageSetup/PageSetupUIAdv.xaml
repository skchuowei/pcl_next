<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PCL.PageSetupUIAdv"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyHint Theme="Yellow" Margin="0,0,0,12" Text="该选项仅供开发测试使用。所有调整仅叠加在主题之上、实时预览，重置即可恢复正式配色与动画基线，不会影响其它页面。" />

            <local:MyCard Margin="0,0,0,15" Title="配色设置">
                <StackPanel Margin="25,40,25,17">
                    <local:MyColorEdit Title="主题色（含标题栏）" local:SettingService.Key="UiDevColorAccent" BaseBrushKey="ColorBrush3" />
                    <local:MyColorEdit Title="背景色" local:SettingService.Key="UiDevColorBg" BaseBrushKey="ColorBrushWindow" />
                    <local:MyColorEdit Title="文字色" local:SettingService.Key="UiDevColorText" BaseBrushKey="ColorBrush1" />
                    <local:MyColorEdit Title="按钮 · 默认" local:SettingService.Key="UiDevColorBtnDefault" BaseBrushKey="ColorBrushButton" />
                    <local:MyColorEdit Title="按钮 · 悬停" local:SettingService.Key="UiDevColorBtnHover" BaseBrushKey="ColorBrushButtonHover" />
                    <local:MyColorEdit Title="按钮 · 按下" local:SettingService.Key="UiDevColorBtnPressed" BaseBrushKey="ColorBrushButtonPressed" />
                    <local:MyColorEdit Title="按钮 · 禁用" local:SettingService.Key="UiDevColorBtnDisabled" BaseBrushKey="ColorBrushButtonDisabled" />
                    <local:MyColorEdit Title="弹窗色" local:SettingService.Key="UiDevColorPopup" BaseBrushKey="ColorBrushPopup" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="动画设置">
                <Grid Margin="25,40,25,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="动画速度" Margin="0,0,20,0" />
                    <local:MySlider local:SettingService.Key="UiDevAnimSpeed" MaxValue="30" ValueByKey="1" Grid.Column="1" x:Name="SliderAnimSpeed" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="动画缓动" Margin="0,14,20,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyRadioBox local:SettingService.Key="UiDevAnimEase" local:SettingService.Value="0" Text="线性" Margin="0,0,16,0" />
                        <local:MyRadioBox local:SettingService.Key="UiDevAnimEase" local:SettingService.Value="1" Text="标准" Margin="0,0,16,0" />
                        <local:MyRadioBox local:SettingService.Key="UiDevAnimEase" local:SettingService.Value="2" Text="缓入" Margin="0,0,16,0" />
                        <local:MyRadioBox local:SettingService.Key="UiDevAnimEase" local:SettingService.Value="3" Text="缓出" />
                    </StackPanel>
                    <local:MyButton Grid.Row="2" Grid.Column="1" x:Name="BtnResetAll" Width="120" Height="32" Margin="0,16,0,0" Text="恢复默认" HorizontalAlignment="Left" Padding="0" />
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
