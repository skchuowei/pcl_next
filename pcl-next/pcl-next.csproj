<Project Sdk="Microsoft.NET.Sdk">
  <!--
    pcl-next：基于 PCL2 的第三方分支，目标运行时 .NET 10（net10.0-windows）。
    同目录下原有的 net48 工程（Plain Craft Launcher 2.vbproj）已于本分支弃用并删除，
    因此本工程是该目录的唯一入口；构建输出到 bin-net10，单文件发布配置见
    Properties/PublishProfiles/win-x64-single.pubxml。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>PCL.PclEntryPoint</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      最低 Windows 版本。注意：本工程设置了 <GenerateAssemblyInfo>false</GenerateAssemblyInfo>，
      SDK 因此不会自动产出 SupportedOSPlatform 程序集特性，CA1416 会把程序集当成「可在所有平台运行」，
      对每个 [SupportedOSPlatform("windows7.0")] 的 API 都报「仅在该版本以上受支持」（实测 1300 条）。
      真正消除警告的是 My Project\AssemblyInfo.cs 里的 [assembly: SupportedOSPlatform("windows7.0")]，
      这里保留该属性只是让 TargetPlatformMinVersion 与实际最低版本一致。
    -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PCL</RootNamespace>
    <AssemblyName>pcl-next</AssemblyName>
    <!-- 不再使用 VB 的 My 命名空间（My.Computer 等由 Modules/Base/MyCompat.vb 补齐） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
    <!-- 不使用面向 .NET Framework 的 App.config（其中的 system.net 段在 net10 上会直接报错） -->
    <AppConfig>App.net10.config</AppConfig>
    <!--
      产物路径：**不得**在此手写 bin-net10\... 字面量，一律用 Directory.Build.props 的
      PclGuiTreeRoot（= pcl-next\bin-net10\<代号>\<版本>\<RID>\，见 AGENTS §0.1）。

      历史教训（2026-11-01）：这里曾写死 `<OutputPath>bin-net10\$(PclChannel)\</OutputPath>`，
      只有「代号」一段。MSBuild 求值顺序是 Directory.Build.props 先、工程体后，于是这行
      把三段树覆盖成了单层树，版本层整个丢失：
        无 -r 构建 → bin-net10\Dev\            （连 RID 都没有，看起来像「跑到 bin 根」）
        带 -r 构建 → bin-net10\Dev\win-x64\    （RID 是 SDK 自动追加的，纯属巧合）
      而 scripts\Build.ps1 靠外部 -p:OutputPath 硬灌三段路径，所以只有走脚本才是对的，
      两套目录并存 → IDE 编译与脚本编译的产物互不可见，表现成「改了代码没生效」。
    -->
    <OutputPath>$(PclGuiTreeRoot)</OutputPath>
    <!-- 必须关掉：否则 SDK 会在已是 ...\<版本>\<RID>\ 的路径后再追加一层同名 RID -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 启用 Directory.Build.props 的 PclTreePathGuard（OutputPath 必须含代号与版本两段） -->
    <PclUseTreePath>true</PclUseTreePath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 沿用原工程的 VB 警告豁免 -->
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314,</NoWarn>
    <!--
      以下两条是「VB 本来就不警告、C# 才警告」的结构性差异，且修掉它们会改变语义，故豁免：
        CS0659 / CS0661：类重写 Equals 但未重写 GetHashCode（共 16 个类，如 ModBase.MyColor、
                         ModMinecraft.McInstance、ModNet.NetThread）。上游 VB 从未实现 GetHashCode，
                         行为等于继承 object.GetHashCode()。若在此补一个 GetHashCode 只是为了消警告，
                         反而会让人误以为哈希语义已被正确实现；保持原状并在后续专项里统一处理。
    -->
    <NoWarn>$(NoWarn);CS0659;CS0661</NoWarn>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <!--
    渠道（发布通道）代号。

    与《分支与发布规范》的六条长期分支一一对应，渠道不再是「构建配置」的附属物，
    而是「分支」的附属物——因此由 CI 按分支注入编译期常量，见 §5.4：

        Dev      → PCL_CHANNEL_DEV       开发版   （dev 分支）
        Slush    → PCL_CHANNEL_SLUSH     收敛版   （slush 分支）
        Alpha    → PCL_CHANNEL_ALPHA     内测版   （alpha 分支）
        Beta     → PCL_CHANNEL_BETA      公测版   （beta 分支）
        Rc       → PCL_CHANNEL_RC        正式版   （rc 分支）
        Snapshot → PCL_CHANNEL_SNAPSHOT  快照/SP  （snapshot 分支）

    用法：dotnet build -p:PclChannel=Alpha
    未显式指定时：Configuration = Snapshot 时取 Snapshot，其余取 Dev（与 dev 分支一致）。
  -->
  <PropertyGroup>
    <PclChannel Condition="'$(PclChannel)' == '' AND '$(Configuration)' == 'Snapshot'">Snapshot</PclChannel>
    <PclChannel Condition="'$(PclChannel)' == ''">Dev</PclChannel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Dev'">
    <PclChannelConstant>PCL_CHANNEL_DEV</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Slush'">
    <PclChannelConstant>PCL_CHANNEL_SLUSH</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Alpha'">
    <PclChannelConstant>PCL_CHANNEL_ALPHA</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Beta'">
    <PclChannelConstant>PCL_CHANNEL_BETA</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Rc'">
    <PclChannelConstant>PCL_CHANNEL_RC</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Snapshot'">
    <PclChannelConstant>PCL_CHANNEL_SNAPSHOT</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup>
    <PclDefineConstants Condition="'$(DefineConstants)' != ''">$(DefineConstants);$(PclChannelConstant)</PclDefineConstants>
    <PclDefineConstants Condition="'$(PclDefineConstants)' == ''">$(PclChannelConstant)</PclDefineConstants>
    <DefineConstants>$(PclDefineConstants)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Snapshot'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- My.Settings 在本分支未被使用，排除其设计器代码（依赖 System.Configuration 的旧模型） -->
    <Compile Remove="My Project\Settings.Designer.cs" />
    <Compile Remove="My Project\MyExtensions\MyWpfExtension.cs" />
    <!-- 这是供用户替换主页的外观模板，不是页面，原工程也仅作为 None 保留 -->
    <Page Remove="Resources\Custom.xaml" />
    <!-- 上游遗留的死代码：原工程从未编译过该控件（MySlider 才是现役实现） -->
    <Compile Remove="Controls\MySliderDot.xaml.cs" />
    <Page Remove="Controls\MySliderDot.xaml" />
    <None Remove="Images\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- 与原工程一致的工程级 Imports（VB 的 Import 项） -->
  </ItemGroup>
  <ItemGroup>
    <!-- 图片全部作为 WPF 资源打包（原工程逐个列出，这里改为通配） -->
    <Resource Include="Images\**\*.*" />
    <Resource Include="Resources\Font.ttf" />
  </ItemGroup>
  <ItemGroup>
    <!-- 资源基名必须与 Resources.Designer.vb 中的 "PCL.Resources" 一致 -->
    <EmbeddedResource Update="My Project\Resources.resx">
      <LogicalName>PCL.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!--
      第三方依赖统一走 NuGet。
      原先是从 Resources.resx 内嵌 + AppDomain.AssemblyResolve 动态加载 net45 程序集，
      在 .NET 10 上已无必要，且会与依赖解析、单文件发布冲突。
      注：Ookii.Dialogs.Wpf 经核查无任何代码引用，已直接移除；
          ThrottleDebounce 的 Retrier 仍在 ModNet / ModBase / ClipboardInterceptor 使用，必须保留。
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="CacheCow.Client" Version="2.13.1" />
    <PackageReference Include="CacheCow.Client.FileStore" Version="2.13.1" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Imazen.WebP" Version="11.0.0" />
    <PackageReference Include="ThrottleDebounce" Version="2.0.2" />
    <!--
      NU1510：以下两个包在 net10.0-windows + UseWindowsForms 下由 WindowsDesktop 共享框架提供，
      显式 PackageReference 会被裁剪告警。移除引用，改为依赖框架自带版本。
    -->
    <!-- GBK/GB18030 等代码页编码：.NET Core 起需在启动时注册提供程序（包由框架提供，无需引用） -->
  </ItemGroup>
  <ItemGroup>
    <!--
      下载策略的部署期配置文件样例。
      随输出与发布目录一起分发，使这个开关对使用者是可发现、可修改的；
      放在启动器同级目录，ModDownloadPolicy 会在首次读取策略时解析它。
    -->
    <None Update="DownloadPolicy.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" />
    <ProjectReference Include="..\MeloongCore\Wpf\MeloongCore.Wpf.csproj" />
    <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    <ProjectReference Include="..\PCLCS\PCLCS.csproj" />
    <ProjectReference Include="..\PCL.Download\PCL.Download.csproj" />
  </ItemGroup>
  <!--
    渠道切换时强制重新编译。

    VB 的增量编译只比对源文件与程序集的时间戳，不会因为 DefineConstants 变化而重新编译，
    因此切换渠道后若沿用同一份中间产物，就会把上一个渠道的常量编译进产物
    （曾出现「传 -p:PclChannel=Dev 却跑出 rc 渠道」的产物）。
    这里记录上次编译的渠道，与本次不一致时删除中间程序集，逼编译器重编。

    注：不能通过自定义 IntermediateOutputPath 来隔离渠道——
    WPF 的标记编译会生成临时工程并复用同一份中间目录，自定义路径会让两遍编译互相污染。
  -->
  <Target Name="PclChannelGuard" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_PclChannelStamp>$(IntermediateOutputPath)PclChannel.stamp</_PclChannelStamp>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_PclChannelStamp)" Condition="Exists('$(_PclChannelStamp)')">
      <Output TaskParameter="Lines" ItemName="_PclChannelRecorded" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PclChannelRecordedValue>@(_PclChannelRecorded)</_PclChannelRecordedValue>
    </PropertyGroup>
    <Delete Files="@(IntermediateAssembly)" Condition="'$(_PclChannelRecordedValue)' != '$(PclChannel)'" />
    <Message Importance="high" Text="PclChannelGuard: recorded=[$(_PclChannelRecordedValue)] current=[$(PclChannel)] const=[$(PclChannelConstant)] defines=[$(DefineConstants)] asm=[@(IntermediateAssembly)]" />
    <WriteLinesToFile File="$(_PclChannelStamp)" Lines="$(PclChannel)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <!--
    单文件发布收尾：被引用工程仍会把 .pdb 与 app.config 派生的 *.dll.config 复制到发布目录，
    单文件模式下这两类文件既无用、也让「产物只有一个 exe」的说法失真，这里统一清掉。
  -->
  <Target Name="PclCleanSingleFileLeftovers" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_PclPublishLeftover Include="$(PublishDir)*.pdb" />
      <_PclPublishLeftover Include="$(PublishDir)*.dll.config" />
    </ItemGroup>
    <Delete Files="@(_PclPublishLeftover)" ContinueOnError="true" />
  </Target>
  <!--
    构建小版本（《分支与发布规范》§5.2.1）：
    编译前根据 git 状态推导「(自本周期起点以来的提交数 + 本机累计编译次数) × 0.01」，生成 obj\PclBuildInfo.g.cs，
    内含 AssemblyInformationalVersion 与 PclBuildInfoGenerated 数据类，
    使任何一份产物都能反查到构建时的提交（exe 属性 → 详细信息 → 产品版本）。

    生成的源文件内容未变时不重写，避免每次构建都触发整包重编译。
    非 git 环境（如源码压缩包）退化为 0.00 / nogit，不阻断构建。
  -->
  <Target Name="PclBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_PclBuildInfoFile>$(IntermediateOutputPath)PclBuildInfo.g.cs</_PclBuildInfoFile>
      <!--
        缓存文件固定放在 obj\pcl-build.small（不带配置层），与 Directory.Build.props 的
        PclBuildCacheFile 必须完全一致，否则求值期读的和这里写的不是同一个文件。
        顺带在这里刷新缓存：IDE 里直接编译（没走 Build.ps1、也没装钩子）时，
        本次目录名可能仍用旧值，但下一次就正确了，不会长期缺段。
      -->
      <_PclBuildCacheFile>$(MSBuildProjectDirectory)\obj\pcl-build.small</_PclBuildCacheFile>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Get-BuildSmallVersion.ps1&quot; -RepoRoot &quot;$(MSBuildProjectDirectory)\..&quot; -OutFile &quot;$(_PclBuildInfoFile)&quot; -CacheFile &quot;$(_PclBuildCacheFile)&quot;" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    <ItemGroup>
      <Compile Include="$(_PclBuildInfoFile)" Condition="Exists('$(_PclBuildInfoFile)')" />
    </ItemGroup>
  </Target>
  <!--
    产物命名：在 pcl-next.exe 旁边另存一份 PCL-Next-<版本名>-<代号>-<构建号>[-dirty].exe，
    原始文件名保持不变——XAML 里大量 `/pcl-next;component/...` 的资源 URI 依赖 AssemblyName，
    改它会导致图片等资源全部加载失败。版本名读产物自身的 FileVersion，构建号读 git，
    两者都不需要额外维护。规则见《分支与发布规范》§5.2.1 / §5.3。
  -->
  <Target Name="PclVersionedArtifact" AfterTargets="Build">
    <!--
      C# 工程里 $(TargetPath) 指向托管程序集 pcl-next.dll（VB 工程才指向 .exe），
      真正的可执行入口是 apphost $(TargetDir)$(AssemblyName).exe，必须显式拼出来，
      否则会把 dll 改名成 exe 复制到产物旁边，得到一个双击就跑不起来的假 exe。
    -->
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Copy-VersionedArtifact.ps1&quot; -ExePath &quot;$(TargetDir)$(AssemblyName).exe&quot; -Channel &quot;$(PclChannel)&quot;&#xD;&#xA;" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>
  <Target Name="PclVersionedArtifactPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Copy-VersionedArtifact.ps1&quot; -ExePath &quot;$(PublishDir)$(AssemblyName).exe&quot; -Channel &quot;$(PclChannel)&quot;&#xD;&#xA;" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>
  <!--
    构建号「每次编译 +0.01」（2026-11-14 用户裁决，规则见《分支与发布规范》§5.2.1）：
    构建**成功结束后**把本机累计编译次数加 1 并写回 obj\pcl-build.seq / pcl-build.small，
    下一次编译换用下一个编号，同一提交下反复编译不再共用同一个 M.mm。

    为什么放在「结束」而不是「开始」：
    目录名（OutputPath）在 MSBuild **属性求值期**就定下了，那之前无法执行 git / 脚本；
    若在编译中途改缓存，会出现「目录是 1.22、exe 里写着 1.23」的脱钩。
    结束时递增，本次构建的三个落点（目录名、AssemblyInformationalVersion、制品名）
    仍由同一份缓存决定，下一次构建才换号，三者永远同源。

    发布构建必须传 -p:PclNoBump=true：同一 commit 的 x64 / arm64 两个制品要共用同一个编号，
    且发布号要回到纯提交语义（与 tag 对齐）；Directory.Build.props 检测到 PublishProfile 时
    也会自动置 PclNoBump=true。
  -->
  <Target Name="PclBuildSeqBump" AfterTargets="PclVersionedArtifact" Condition="'$(PclNoBump)' != 'true'">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Get-BuildSmallVersion.ps1&quot; -RepoRoot &quot;$(MSBuildProjectDirectory)\..&quot; -BumpSeq" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>
</Project>