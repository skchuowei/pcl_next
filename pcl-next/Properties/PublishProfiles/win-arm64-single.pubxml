<?xml version="1.0" encoding="utf-8"?>
<!--
  pcl-next 单文件自包含发布配置（win-arm64）。

  用法：
    dotnet publish pcl-next/pcl-next.csproj -c Release -r win-arm64 -p:PclChannel=<代号> -p:PublishProfile=win-arm64-single
  产物：
    publish\win-arm64\<渠道>\pcl-next.exe（单文件，内含 .NET 10 arm64 运行时，目标机无需安装任何运行时）

  为什么必须单独一份 profile（《分支与发布规范》§5.3.1）：
    PublishDir 与 RuntimeIdentifier 都写死在 profile 里。复用 win-x64-single 会导致
    arm64 产物写进 publish\win-x64\<渠道>\ 并覆盖掉 x64 的 exe —— 两个 RID 共用发布目录是硬错误，
    事后无法从目录名分辨哪个 exe 属于哪个架构（只能靠 PE Machine 反查）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- 发布目录按渠道区分，且必须与 win-x64 分属不同顶层目录 -->
    <PublishDir>publish\win-arm64\$(PclChannel)\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF 的 native/依赖库需要随包自解压，否则运行时会找不到 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 交叉 ReadyToRun：x64 主机可生成 arm64 的 R2R 镜像，配置必须与 win-x64 保持一致 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF 不支持裁剪 -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 单文件下重复文件由打包器处理，不必因此中断发布 -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
</Project>
