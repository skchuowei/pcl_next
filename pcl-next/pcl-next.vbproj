<Project Sdk="Microsoft.NET.Sdk">

  <!--
    pcl-next：基于 PCL2 的第三方分支，目标运行时 .NET 10（net10.0-windows）。
    同目录下原有的 net48 工程（Plain Craft Launcher 2.vbproj）已于本分支弃用并删除，
    因此本工程是该目录的唯一入口；构建输出到 bin-net10，单文件发布配置见
    Properties/PublishProfiles/win-x64-single.pubxml。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PCL</RootNamespace>
    <AssemblyName>pcl-next</AssemblyName>
    <!-- 不再使用 VB 的 My 命名空间（My.Computer 等由 Modules/Base/MyCompat.vb 补齐） -->
    <MyType>Empty</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
    <!-- 不使用面向 .NET Framework 的 App.config（其中的 system.net 段在 net10 上会直接报错） -->
    <AppConfig>App.net10.config</AppConfig>
    <OutputPath>bin-net10\$(PclChannel)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>false</DefineTrace>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 沿用原工程的 VB 警告豁免 -->
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314,BC40000,BC42024,BC42030,BC42104,BC42353</NoWarn>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!--
    渠道（发布通道）代号。

    与《分支与发布规范》的六条长期分支一一对应，渠道不再是「构建配置」的附属物，
    而是「分支」的附属物——因此由 CI 按分支注入编译期常量，见 §5.4：

        Dev      → PCL_CHANNEL_DEV       开发版   （dev 分支）
        Slush    → PCL_CHANNEL_SLUSH     收敛版   （slush 分支）
        Alpha    → PCL_CHANNEL_ALPHA     内测版   （alpha 分支）
        Beta     → PCL_CHANNEL_BETA      公测版   （beta 分支）
        Rc       → PCL_CHANNEL_RC        正式版   （rc 分支）
        Snapshot → PCL_CHANNEL_SNAPSHOT  快照/SP  （snapshot 分支）

    用法：dotnet build -p:PclChannel=Alpha
    未显式指定时：Configuration = Snapshot 时取 Snapshot，其余取 Dev（与 dev 分支一致）。
  -->
  <PropertyGroup>
    <PclChannel Condition="'$(PclChannel)' == '' AND '$(Configuration)' == 'Snapshot'">Snapshot</PclChannel>
    <PclChannel Condition="'$(PclChannel)' == ''">Dev</PclChannel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Dev'">
    <PclChannelConstant>PCL_CHANNEL_DEV</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Slush'">
    <PclChannelConstant>PCL_CHANNEL_SLUSH</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Alpha'">
    <PclChannelConstant>PCL_CHANNEL_ALPHA</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Beta'">
    <PclChannelConstant>PCL_CHANNEL_BETA</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Rc'">
    <PclChannelConstant>PCL_CHANNEL_RC</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PclChannel)' == 'Snapshot'">
    <PclChannelConstant>PCL_CHANNEL_SNAPSHOT</PclChannelConstant>
  </PropertyGroup>
  <PropertyGroup>
    <PclDefineConstants Condition="'$(DefineConstants)' != ''">$(DefineConstants);$(PclChannelConstant)</PclDefineConstants>
    <PclDefineConstants Condition="'$(PclDefineConstants)' == ''">$(PclChannelConstant)</PclDefineConstants>
    <DefineConstants>$(PclDefineConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Snapshot'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- My.Settings 在本分支未被使用，排除其设计器代码（依赖 System.Configuration 的旧模型） -->
    <Compile Remove="My Project\Settings.Designer.vb" />
    <Compile Remove="My Project\MyExtensions\MyWpfExtension.vb" />
    <!-- 这是供用户替换主页的外观模板，不是页面，原工程也仅作为 None 保留 -->
    <Page Remove="Resources\Custom.xaml" />
    <!-- 上游遗留的死代码：原工程从未编译过该控件（MySlider 才是现役实现） -->
    <Compile Remove="Controls\MySliderDot.xaml.vb" />
    <Page Remove="Controls\MySliderDot.xaml" />
    <None Remove="Images\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与原工程一致的工程级 Imports（VB 的 Import 项） -->
    <Import Include="MeloongCore" />
    <Import Include="MeloongCore.Extensions" />
    <Import Include="MeloongCore.Wpf" />
    <Import Include="MeloongCore.Wpf.Extensions" />
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="Newtonsoft.Json" />
    <Import Include="Newtonsoft.Json.Linq" />
    <Import Include="PCLCS" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.IO.Compression" />
    <Import Include="System.Linq" />
    <Import Include="System.Net" />
    <Import Include="System.Net.Http" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Xml.Linq" />
    <Import Include="ThrottleDebounce" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图片全部作为 WPF 资源打包（原工程逐个列出，这里改为通配） -->
    <Resource Include="Images\**\*.*" />
    <Resource Include="Resources\Font.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- 资源基名必须与 Resources.Designer.vb 中的 "PCL.Resources" 一致 -->
    <EmbeddedResource Update="My Project\Resources.resx">
      <LogicalName>PCL.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
      第三方依赖统一走 NuGet。
      原先是从 Resources.resx 内嵌 + AppDomain.AssemblyResolve 动态加载 net45 程序集，
      在 .NET 10 上已无必要，且会与依赖解析、单文件发布冲突。
      注：Ookii.Dialogs.Wpf 经核查无任何代码引用，已直接移除；
          ThrottleDebounce 的 Retrier 仍在 ModNet / ModBase / ClipboardInterceptor 使用，必须保留。
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="CacheCow.Client" Version="2.13.1" />
    <PackageReference Include="CacheCow.Client.FileStore" Version="2.13.1" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Imazen.WebP" Version="11.0.0" />
    <PackageReference Include="ThrottleDebounce" Version="2.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- GBK/GB18030 等代码页编码：.NET Core 起需显式引入并在启动时注册提供程序 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      下载策略的部署期配置文件样例。
      随输出与发布目录一起分发，使这个开关对使用者是可发现、可修改的；
      放在启动器同级目录，ModDownloadPolicy 会在首次读取策略时解析它。
    -->
    <None Update="DownloadPolicy.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" />
    <ProjectReference Include="..\MeloongCore\Wpf\MeloongCore.Wpf.csproj" />
    <ProjectReference Include="..\PCLCS\PCLCS.csproj" />
    <ProjectReference Include="..\PCL.Download\PCL.Download.csproj" />
  </ItemGroup>

  <!--
    渠道切换时强制重新编译。

    VB 的增量编译只比对源文件与程序集的时间戳，不会因为 DefineConstants 变化而重新编译，
    因此切换渠道后若沿用同一份中间产物，就会把上一个渠道的常量编译进产物
    （曾出现「传 -p:PclChannel=Dev 却跑出 rc 渠道」的产物）。
    这里记录上次编译的渠道，与本次不一致时删除中间程序集，逼编译器重编。

    注：不能通过自定义 IntermediateOutputPath 来隔离渠道——
    WPF 的标记编译会生成临时工程并复用同一份中间目录，自定义路径会让两遍编译互相污染。
  -->
  <Target Name="PclChannelGuard" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_PclChannelStamp>$(IntermediateOutputPath)PclChannel.stamp</_PclChannelStamp>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_PclChannelStamp)" Condition="Exists('$(_PclChannelStamp)')">
      <Output TaskParameter="Lines" ItemName="_PclChannelRecorded" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PclChannelRecordedValue>@(_PclChannelRecorded)</_PclChannelRecordedValue>
    </PropertyGroup>
    <Delete Files="@(IntermediateAssembly)" Condition="'$(_PclChannelRecordedValue)' != '$(PclChannel)'" />
    <Message Importance="high" Text="PclChannelGuard: recorded=[$(_PclChannelRecordedValue)] current=[$(PclChannel)] const=[$(PclChannelConstant)] defines=[$(DefineConstants)] asm=[@(IntermediateAssembly)]" />
    <WriteLinesToFile File="$(_PclChannelStamp)" Lines="$(PclChannel)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!--
    单文件发布收尾：被引用工程仍会把 .pdb 与 app.config 派生的 *.dll.config 复制到发布目录，
    单文件模式下这两类文件既无用、也让「产物只有一个 exe」的说法失真，这里统一清掉。
  -->
  <Target Name="PclCleanSingleFileLeftovers" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_PclPublishLeftover Include="$(PublishDir)*.pdb" />
      <_PclPublishLeftover Include="$(PublishDir)*.dll.config" />
    </ItemGroup>
    <Delete Files="@(_PclPublishLeftover)" ContinueOnError="true" />
  </Target>

</Project>
