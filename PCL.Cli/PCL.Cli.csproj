<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>pclcli</AssemblyName>
    <RootNamespace>PCL.Cli</RootNamespace>
    <Configurations>Debug;Release;Snapshot</Configurations>
    <Deterministic>true</Deterministic>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 控制台入口，不做 WPF/程序集特性生成 -->
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      架构护栏（Directory.Build.props §3）：CLI 是内核的第二个前端，
      引用闭包内只允许出现 PCL.Download，不得出现 WPF 或 GUI 宿主程序集。
    -->
    <PclIsGuiFree>true</PclIsGuiFree>
  </PropertyGroup>

  <!--
    产物落在三段树内的 cli\ 子层（AGENTS §0.1 / 计划 §4）。
    无条件赋值：原写法带 Condition="'$(OutputPath)' == ''"，等于给外部 -p:OutputPath
    留了第二处真相源，一旦被外部覆盖就会绕过 PclTreePathGuard 的校验语义。
  -->
  <PropertyGroup>
    <OutputPath>$(PclTreeRoot)cli\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PclUseTreePath>true</PclUseTreePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一的工程引用：CLI 不得直接引用 pcl-next / PCLCS / MeloongCore -->
    <ProjectReference Include="..\PCL.Download\PCL.Download.csproj" />
  </ItemGroup>

</Project>
