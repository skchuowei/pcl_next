<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCL.Desktop.Linux.MainWindow"
        Title="pcl-next · Linux"
        Width="960"
        Height="640">
    <!--
      LU1 骨架：只验证「能起窗口」，不画任何 PCL 页面。
      LU2 起主题与控件落位后，这里才会换成承载 P0 视图的宿主。
    -->
    <StackPanel Margin="24" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="pcl-next · Linux 宿主骨架（LU1）"
                   FontSize="20" />
        <TextBlock Text="Avalonia + linux-x64；UI 组件尚未落位（见 docs/plans/计划-LinuxUI移植.md §11 D1）。"
                   FontSize="13" />
    </StackPanel>
</Window>
