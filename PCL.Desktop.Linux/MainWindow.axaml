<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:PCL.Desktop.Linux.Controls"
        xmlns:views="using:PCL.Desktop.Linux.Views"
        x:Class="PCL.Desktop.Linux.MainWindow"
        Title="PCL Next"
        Width="850"
        Height="500"
        MinWidth="810"
        MinHeight="470"
        SystemDecorations="None"
        CanResize="True"
        Background="{DynamicResource ColorBrush1}"
        WindowStartupLocation="CenterScreen"
        RenderTransformOrigin="0.5,0.5">

    <!--
      外壳 1:1 对照 pcl-next/FormMain.xaml：
        · Window         → 无边框 / 可缩放（原 WindowStyle=None、AllowsTransparency=True、Background=null）
        · PanBack        → Margin 10，开场时 translate(0,60px) rotate(-4°) 归零（原 TransformGroup）
        · 8 个缩放热区   → 原 ResizerT/B/L/R + 四角，宽 8 / 角 13，渐变照抄（L26–L81）
        · BorderForm     → Margin 8、圆角 6、裁剪（原 RectangleGeometry RadiusX/Y=6）
        · PanForm        → 行 Auto(标题栏 48) / 1*（内容），背景为 UiBackgroundColorful 渐变（ModSecret.vb L124–L132）
        · PanTitle       → 高度 48、渐变（ModSecret.vb L116–L121），logo 文字「PCL Next」17 号白字 Margin 18,0,0,0
                           （UiLogoType 默认 1，FormMain.xaml.vb L826–L834 / L862–L866），5 个 MyRadioButton
                           （Margin 5,0、LogoScale 0.90/0.90/1.05/1.10/0.93，FormMain.xaml L121–L130），
                           最小化 Margin 0,0,44,0 / 关闭 Margin 0,0,12,0、28×28、LogoScale 0.72
        · PanLeft        → 左侧竖条底（宽 0）+ 4px 渐变阴影（L144–L152）
        · PanMain        → 左页（Auto 列）+ 右页（1* 列）（L154–L167）
      未接入项（登记 R18）：ImgBack 背景图、PanTitleInner、PanHint、BtnExtra*、左侧栏宽度动画。
    -->

    <Window.Resources>
        <!-- 缩放热区渐变：逐条照抄 FormMain.xaml L26–L81 -->
        <LinearGradientBrush x:Key="ResizerTopBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#11000000" Offset="0.7" />
            <GradientStop Color="#21000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ResizerBottomBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#21000000" Offset="0" />
            <GradientStop Color="#11000000" Offset="0.3" />
            <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ResizerRightBrush" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Color="#21000000" Offset="0" />
            <GradientStop Color="#11000000" Offset="0.3" />
            <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ResizerLeftBrush" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Color="#21000000" Offset="1" />
            <GradientStop Color="#11000000" Offset="0.7" />
            <GradientStop Color="#00000000" Offset="0" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="ResizerLeftTopBrush" Center="100%,100%" GradientOrigin="100%,100%"
                             RadiusX="1" RadiusY="1">
            <GradientStop Color="#21000000" Offset="0.2" />
            <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="ResizerLeftBottomBrush" Center="100%,0%" GradientOrigin="100%,0%"
                             RadiusX="1" RadiusY="1">
            <GradientStop Color="#21000000" Offset="0.2" />
            <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="ResizerRightBottomBrush" Center="0%,0%" GradientOrigin="0%,0%"
                             RadiusX="1" RadiusY="1">
            <GradientStop Color="#21000000" Offset="0.2" />
            <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="ResizerRightTopBrush" Center="0%,100%" GradientOrigin="0%,100%"
                             RadiusX="1" RadiusY="1">
            <GradientStop Color="#21000000" Offset="0.2" />
            <GradientStop Color="#00000000" Offset="1" />
        </RadialGradientBrush>
    </Window.Resources>

    <Grid Name="PanBack" Margin="10" RenderTransformOrigin="0.5,0.5">
        <!-- 缩放热区（上 / 下 / 左 / 右 / 四角），事件在代码后置里挂 BeginResizeDrag -->
        <Rectangle Name="ResizerT" Height="8" VerticalAlignment="Top" Margin="13,0" Fill="{StaticResource ResizerTopBrush}" />
        <Rectangle Name="ResizerB" Height="8" VerticalAlignment="Bottom" Margin="13,0" Fill="{StaticResource ResizerBottomBrush}" />
        <Rectangle Name="ResizerR" Width="8" HorizontalAlignment="Right" Margin="0,13" Fill="{StaticResource ResizerRightBrush}" />
        <Rectangle Name="ResizerL" Width="8" HorizontalAlignment="Left" Margin="0,13" Fill="{StaticResource ResizerLeftBrush}" />
        <Rectangle Name="ResizerLT" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource ResizerLeftTopBrush}" />
        <Rectangle Name="ResizerLB" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{StaticResource ResizerLeftBottomBrush}" />
        <Rectangle Name="ResizerRB" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource ResizerRightBottomBrush}" />
        <Rectangle Name="ResizerRT" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{StaticResource ResizerRightTopBrush}" />

        <Border Name="BorderForm" Margin="8" CornerRadius="6" ClipToBounds="True">
            <Grid Name="PanForm">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== 标题栏（FormMain.xaml L96–L138） ===== -->
                <Grid Name="PanTitle" Height="48">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="{DynamicResource ColorObject4}" Offset="0" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid Name="PanTitleMain" ColumnDefinitions="1*,Auto,1*">
                        <TextBlock Name="LabTitleLogo"
                                   Grid.Column="0"
                                   Text="PCL Next"
                                   FontSize="17"
                                   Foreground="White"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   IsHitTestVisible="False" />

                        <StackPanel Name="PanTitleSelect"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Height="27"
                                    Margin="13,0"
                                    VerticalAlignment="Center">
                            <c:MyRadioButton Name="BtnTitleSelect0" Text="启动" Tag="0" Margin="5,0" LogoScale="0.9"
                                             Logo="M52.1,164.5c-1.4,0-3.1-0.5-4.2-1.3c-2.6-1.7-4-4.2-4-7V43.8c0-2.9,1.6-5.8,4.1-7c1.2-0.8,2.7-1.2,4.1-1.2c1.5,0,2.9,0.4,4.2,1.2L153.1,93c0,0,0.1,0,0.1,0.1c2.6,1.7,4,4.2,4,7c0,3-1.7,5.8-4.2,7.1l-96.8,56.2C55.1,164,53.5,164.5,52.1,164.5z M60.4,142.1l72.1-42.1L60.4,58.2V142.1z" />
                            <c:MyRadioButton Name="BtnTitleSelect1" Text="下载" Tag="1" Margin="5,0" LogoScale="0.9"
                                             Logo="M955 610h-59c-15 0-29 13-29 29v196c0 15-13 29-29 29h-649c-15 0-29-13-29-29v-196c0-15-13-29-29-29h-59c-15 0-29 13-29 29V905c0 43 35 78 78 78h787c43 0 78-35 78-78V640c0-15-13-29-29-29zM492 740c11 11 29 11 41 0l265-265c11-11 11-29 0-41l-41-41c-11-11-29-11-41 0l-110 110c-11 11-33 3-33-13V68C571 53 555 39 541 39h-59c-15 0-29 13-29 29v417c0 17-21 25-33 13l-110-110c-11-11-29-11-41 0L226 433c-11 11-11 29 0 41L492 740z" />
                            <c:MyRadioButton Name="BtnTitleSelect2" Text="联机" Tag="2" Margin="5,0" LogoScale="1.05" Checked="True"
                                             Logo="M512 817c-48.601 0-88-39.399-88-88s39.399-88 88-88 88 39.399 88 88-39.399 88-88 88zM237.671 565.74C308.335 474.58 397.369 429 504.774 429c118.433 0 214.225 55.421 287.377 166.264l-53.407 30.369c-13.84 7.87-31.362 4.367-41.114-8.219-50.291-64.911-114.577-97.367-192.856-97.367-86.851 0-156.835 40.318-209.95 120.953l-47.995-28.02c-15.263-8.91-20.412-28.507-11.502-43.77a32 32 0 0 1 2.344-3.47zM107.691 419.47C205.24 278.491 337.805 208 505.379 208c178.77 0 317.694 80.224 416.772 240.672l-56.54 31.73c-13.686 7.68-30.922 4.303-40.697-7.975C735.581 360.213 629.07 303.009 505.38 300.815 373.997 298.485 261.637 362.88 168.3 494l-50.116-28.505c-15.362-8.738-20.732-28.275-11.994-43.637a32 32 0 0 1 1.5-2.387z" />
                            <c:MyRadioButton Name="BtnTitleSelect3" Text="设置" Tag="3" Margin="5,0" LogoScale="1.1"
                                             Logo="M940.4 463.7L773.3 174.2c-17.3-30-49.2-48.4-83.8-48.4H340.2c-34.6 0-66.5 18.5-83.8 48.4L89.2 463.7c-17.3 30-17.3 66.9 0 96.8L256.4 850c17.3 30 49.2 48.4 83.8 48.4h349.2c34.6 0 66.5-18.5 83.8-48.4l167.2-289.5c17.3-29.9 17.3-66.8 0-96.8z m-94.6 96.8L725.9 768.1c-17.3 30-49.2 48.4-83.8 48.4H387.5c-34.6 0-66.5-18.5-83.8-48.4L183.9 560.5c-17.3-30-17.3-66.9 0-96.8l119.8-207.5c17.3-30 49.2-48.4 83.8-48.4h254.6c34.6 0 66.5 18.5 83.8 48.4l119.8 207.5c17.3 30 17.3 66.9 0.1 96.8z M522.3 321.2c-2.5-0.1-5-0.2-7.5-0.2-119.9 0-214 110.3-186.3 235 15.8 70.9 71.5 126.6 142.4 142.4 17.5 3.9 34.7 5.4 51.4 4.7 102.1-3.9 183.6-87.9 183.6-191 0.1-103-81.5-187-183.6-190.9z m68.6 269.1c-18.5 18-43 28.9-68.6 30.7l-6 0.3c-30.2 0.4-58.6-11.4-79.7-33-19.5-20.1-30.7-47-30.9-75-0.3-29.6 11.1-57.4 32-78.3 20.6-20.6 48-32 77.2-32 2.5 0 5 0.1 7.5 0.3 26.7 1.8 51.5 13.2 70.5 32.5 19.6 20 30.8 46.9 31.2 74.9 0.2 30.2-11.5 58.6-33.2 79.6z" />
                            <c:MyRadioButton Name="BtnTitleSelect4" Text="更多" Tag="4" Margin="5,0" LogoScale="0.93"
                                             Logo="M364 0h-273C40 0 0 40 0 91v273C0 414 40 455 91 455h273C414 455 455 414 455 364V91C455 40 414 0 364 0zM341 341H113V113h227v227zM933 0h-273C609 0 568 40 568 91v273c0 50 40 91 91 91h273C983 455 1024 414 1024 364V91c0-50-40-91-90-91zM910 341h-227V113h227v227zM364 568h-273C40 568 0 609 0 659v273c0 50 40 91 91 91h273C414 1024 455 983 455 932v-273C455 609 414 568 364 568zM341 910H113v-227h227v227zM933 568h-273c-50 0-91 40-91 91v273c0 50 40 91 91 91h273c50 0 90-40 90-91v-273c0-50-40-90-90-90zM910 910h-227v-227h227v227z" />
                        </StackPanel>
                    </Grid>

                    <c:MyIconButton Name="BtnTitleClose"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,12,0"
                                    IconTheme="White"
                                    LogoScale="0.72"
                                    Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                    <c:MyIconButton Name="BtnTitleMin"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,44,0"
                                    IconTheme="White"
                                    LogoScale="0.72"
                                    Logo="F1 M0,0 h15 v2 h-15 v-2 Z" />
                </Grid>

                <!-- ===== 左侧竖条底色与阴影（FormMain.xaml L139–L153；矩形不参与命中） ===== -->
                <Grid Name="PanLeft" Grid.Row="1" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Name="RectLeftBackground"
                               Width="0"
                               Fill="{DynamicResource ColorBrushBackgroundTransparentSidebar}"
                               IsHitTestVisible="False" />
                    <Rectangle Name="RectLeftShadow"
                               Grid.Column="1"
                               Width="4"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" Opacity="0.04">
                                <GradientStop Color="#000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- ===== 页面宿主（FormMain.xaml L154–L167）：左页 Auto 列、右页 1* 列 ===== -->
                <Grid Name="PanMain" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Name="PanMainRight" Grid.Column="1">
                        <ContentControl Name="PageRight">
                            <views:PageSetupLinkView />
                        </ContentControl>
                    </Border>
                    <Border Name="PanMainLeft">
                        <ContentControl Name="PageLeft" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
