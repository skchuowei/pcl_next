<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:PCL.Desktop.Linux.Controls">

    <!--
      控件样式，逐项对照 Windows 端：
        · TextBlock          → pcl-next/Application.xaml L120–L133
        · MyCard             → pcl-next/Controls/MyCard.vb L64–L103、L138–L162
        · MyButton           → pcl-next/Controls/MyButton.xaml + .xaml.vb L74–L174
        · MyTextBox          → pcl-next/Application.xaml L241–L282（模板为精简等价版）
        · MyComboBox         → pcl-next/Application.xaml L336–L405（弹出层模板待补齐，R6）
      尺寸单位与原生一致（WPF 与 Avalonia 均为 DIP）。
    -->

    <!-- ===== TextBlock：字号 13、ColorBrush1、字符省略号、PCL 字族 ===== -->
    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
    </Style>

    <!-- ===== MyCard ===== -->
    <Style Selector="c|MyCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <!-- 外圈阴影：Margin(-3,-4,-3,-3)、圆角 5、静止不透明度 0.07 -->
                        <Border Name="PART_Chrome"
                                Margin="-3,-4,-3,-3"
                                CornerRadius="5"
                                BoxShadow="0 0 6 0 #12343d4a"
                                IsHitTestVisible="False" />
                        <!-- 卡片底：白 245/255、圆角 5 -->
                        <Border Name="PART_Bg"
                                CornerRadius="5"
                                Background="#F5FFFFFF"
                                IsHitTestVisible="False" />
                        <Grid>
                            <TextBlock Name="PART_Title"
                                       Text="{TemplateBinding Title}"
                                       Margin="15,12,0,0"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False">
                                <TextBlock.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Foreground" Duration="0:0:0.09" />
                                    </Transitions>
                                </TextBlock.Transitions>
                            </TextBlock>
                            <ContentPresenter Name="PART_Content"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="c|MyCard:pointerover /template/ Border#PART_Chrome">
        <Setter Property="BoxShadow" Value="0 0 6 0 #66343d4a" />
    </Style>
    <Style Selector="c|MyCard:pointerover /template/ TextBlock#PART_Title">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    </Style>

    <!-- ===== MyButton ===== -->
    <Style Selector="c|MyButton">
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{DynamicResource ColorBrushSemiTransparent}">
                        <Border Name="PART_Fore"
                                CornerRadius="3"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                                </Transitions>
                            </Border.Transitions>
                            <TextBlock Text="{TemplateBinding Text}"
                                       Foreground="{TemplateBinding BorderBrush}"
                                       FontSize="13"
                                       TextTrimming="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="c|MyButton.highlight">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
    </Style>
    <Style Selector="c|MyButton.red">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushRedDark}" />
    </Style>
    <Style Selector="c|MyButton:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrush7}" />
    </Style>
    <Style Selector="c|MyButton.red:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushRedLight}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushRedBack}" />
    </Style>
    <Style Selector="c|MyButton:disabled">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
    </Style>
    <Style Selector="c|MyButton:pressed">
        <Setter Property="RenderTransform" Value="scale(0.955)" />
    </Style>

    <!-- ===== MyTextBox（模板精简等价版：边框 + 内容宿主） ===== -->
    <Style Selector="c|MyTextBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushBg0}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Padding" Value="5,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Name="PART_Border"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <Panel Margin="{TemplateBinding Padding}">
                            <ScrollViewer Name="PART_ContentHost">
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                                               SelectionStart="{TemplateBinding SelectionStart, Mode=TwoWay}"
                                               SelectionEnd="{TemplateBinding SelectionEnd, Mode=TwoWay}"
                                               PasswordChar="{TemplateBinding PasswordChar}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               VerticalAlignment="Center" />
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== MyComboBox（属性级对齐；弹出层模板待补齐） ===== -->
    <Style Selector="c|MyComboBox">
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushBg0}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,0,8,0" />
    </Style>

    <Style Selector="c|MyComboBoxItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!-- ===== MyCheckBox（1:1 对齐 MyCheckBox.xaml；动画用 Transitions 近似，R10） ===== -->
    <Style Selector="c|MyCheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid MinWidth="20" MinHeight="20" Background="Transparent">
                    <Border Name="PART_ShapeBorder" Width="18" Height="18" CornerRadius="3"
                            BorderThickness="1.1" BorderBrush="{DynamicResource ColorBrush1}"
                            Background="{DynamicResource ColorBrushHalfWhite}"
                            Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                                <BrushTransition Property="Background" Duration="0:0:0.1" />
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Path Name="PART_ShapeCheck" Width="12" Height="12" Margin="4,0,0,0"
                          Stretch="None"
                          Data="M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z"
                          Fill="{Binding #PART_ShapeBorder.BorderBrush}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5" RenderTransform="scale(0)">
                        <Path.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                            </Transitions>
                        </Path.Transitions>
                    </Path>
                    <TextBlock Name="PART_LabText" Text="{TemplateBinding Text}" Margin="26,0,0,0"
                               FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                               Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="c|MyCheckBox:checked /template/ Path#PART_ShapeCheck">
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="c|MyCheckBox:checked /template/ Border#PART_ShapeBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
    </Style>
    <Style Selector="c|MyCheckBox:pointerover /template/ Border#PART_ShapeBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="c|MyCheckBox:pointerover /template/ TextBlock#PART_LabText">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="c|MyCheckBox:disabled /template/ Border#PART_ShapeBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
    </Style>
    <Style Selector="c|MyCheckBox:disabled /template/ TextBlock#PART_LabText">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray5}" />
    </Style>
    <Style Selector="c|MyCheckBox:pressed /template/ Border#PART_ShapeBorder">
        <Setter Property="Background" Value="{DynamicResource ColorBrushBg1}" />
        <Setter Property="RenderTransform" Value="scale(0.917)" />
    </Style>

    <!-- ===== MyHint（1:1 对齐 MyHint.xaml；关闭记忆与收高动画未移植，R11） ===== -->
    <Style Selector="c|MyHint">
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="PART_LabText" Text="{TemplateBinding Text}" LineHeight="16"
                                   Margin="0,0,0,-1" Padding="12,9" TextWrapping="Wrap"
                                   FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                   Foreground="{TemplateBinding Foreground}" />
                        <c:MyIconButton Name="PART_BtnClose" Grid.Column="1" Width="20" Height="20"
                                        Margin="0,0,8,0" VerticalAlignment="Center" IconTheme="Custom"
                                        Foreground="{TemplateBinding Foreground}"
                                        Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                                        IsVisible="{TemplateBinding CanClose}" ToolTip.Tip="不再提示" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ===== MyListItem（1:1 对齐 MyListItem.xaml） ===== -->
    <Style Selector="c|MyListItem">
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="PanBack" Height="42" Background="{TemplateBinding Background}"
                      ColumnDefinitions="2,0,4,*,4" RowDefinitions="*,Auto,Auto,*">
                    <TextBlock Name="PART_LabTitle" Grid.Row="1" Grid.Column="3"
                               Text="{TemplateBinding Title}" Margin="4,0,0,0"
                               FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                               Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ===== MyLoading（1:1 对齐 MyLoading.xaml；镐子摆动改为循环旋转近似，R10） ===== -->
    <Style Selector="c|MyLoading">
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{TemplateBinding Background}" RowDefinitions="*,Auto,Auto,*">
                    <Grid Grid.Row="1" Width="60" Height="47" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Path Name="PART_PathPickaxe" Stretch="Uniform" Height="35" Margin="10,6,0,0"
                              StrokeThickness="2" Stroke="{TemplateBinding Foreground}"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              RenderTransformOrigin="0.5,0.5" RenderTransform="rotate(55deg)"
                              Data="M 963.6 858.2 410.816 305.504 C 508.116 213.304 609.204 196.8 711.104 128.6 837.11367 49.573762 879.34045 50.334062 751.5 49.5 611.3 52 471.8 96.2 353.3 182.4 309.8 155.7 252.1 161.2 214.5 198.9 176.9 236.6 171.3 294.2 198 337.7 111.8 456.3 67.6 595.8 65.1 735.9 63.315254 883.82034 65.077966 837.29308 144.2 695.488 212.4 593.588 228.888 492.4 321.088 395.2 L 873.9 948 c 0.60001 0.59999 1.6 0.6 2.2 0 l 87.5 -87.5 c 0.6 -0.7 0.6 -1.6 0 -2.3 z" />
                        <Path Name="PART_PathLeft" Opacity="0" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                              Width="3" Height="5" Data="M0,0L2,0L1,4" Margin="7,41,0,0"
                              RenderTransformOrigin="0.5,0.5" RenderTransform="rotate(-45deg)"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Name="PART_PathRight" Opacity="0" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                              Width="3" Height="5" Data="M0,0L2,0L1,4" Margin="14,41,0,0"
                              RenderTransformOrigin="0.5,0.5" RenderTransform="rotate(45deg)"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Name="PART_PathError" Opacity="0" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                              Width="17" Height="17" Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                              Margin="4,23,0,0" RenderTransformOrigin="0.5,0.5" RenderTransform="scale(0.6)"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Width="25" Height="2" Fill="{TemplateBinding Foreground}"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Name="PART_LabText" Grid.Row="2" Text="加载中" FontSize="16" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top"
                               FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="c|MyLoading /template/ Path#PART_PathPickaxe">
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="INFINITE" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="rotate(35deg)" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="rotate(75deg)" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ===== MyIconButton（1:1 对齐 MyIconButton.xaml；主题色映射待核对，R12） ===== -->
    <Style Selector="c|MyIconButton">
        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="1000" Background="{TemplateBinding Background}" BorderThickness="0.001">
                    <Border Name="PART_PanBack" CornerRadius="1000" BorderThickness="0.001"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                            </Transitions>
                        </Border.Transitions>
                        <Path Name="PART_Path" Stretch="Uniform" Margin="5" RenderTransformOrigin="0.5,0.5"
                              Fill="{TemplateBinding Foreground}" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="c|MyIconButton:pressed /template/ Border#PART_PanBack">
        <Setter Property="RenderTransform" Value="scale(0.8)" />
    </Style>

</Styles>
