<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:PCL.Desktop.Linux.Controls">

    <!--
      控件样式，逐项对照 Windows 端：
        · TextBlock          → pcl-next/Application.xaml L120–L133
        · MyCard             → pcl-next/Controls/MyCard.vb L64–L103、L138–L162
        · MyButton           → pcl-next/Controls/MyButton.xaml + .xaml.vb L74–L174
        · MyTextBox          → pcl-next/Application.xaml L241–L282（模板为精简等价版）
        · MyComboBox         → pcl-next/Application.xaml L336–L405（模板见下方 ControlTheme，自绘）
        · ComboBoxItem      → pcl-next/Application.xaml L447–L469
        · ComboBox 箭头      → pcl-next/Application.xaml L406–L446（ToggleButton）
      尺寸单位与原生一致（WPF 与 Avalonia 均为 DIP）。
      主题基线（计划 §2.2）：凡 Windows 端 OverridesDefaultStyle + 自定义 Template 的控件，
      本仓库一律用自绘 ControlTheme（下方 Styles.Resources），不依赖 Fluent 默认绘制。
    -->

    <Styles.Resources>
        <!-- ===== ComboBox 箭头按钮（对照 Application.xaml L406–L446）
             整块近透明热区（ColorBrushSemiTransparent）+ 15px 宽 V 形箭头，展开时旋转 180°
             缓动曲线近似（WPF CircleEase → Avalonia 默认线性），登记 R10 ===== -->
        <ControlTheme x:Key="MyComboBoxToggleTheme" TargetType="ToggleButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource ColorBrushSemiTransparent}">
                        <Path Width="15"
                              Data="M1,1L4.5,4.5L8,1"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.3,0.5">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                            <Path.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                                </Transitions>
                            </Path.Transitions>
                        </Path>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Path">
                <Setter Property="RenderTransform" Value="rotate(180deg)" />
            </Style>
        </ControlTheme>

        <!-- ===== ComboBox（对照 Application.xaml L336–L370）
             边框色 = 前景色（TemplateBinding Foreground），随 RefreshColor 的 Foreground 过渡一起变色；
             内容 Margin 8.5,0,21.5,0；弹层圆角 3、白底内衬 + 边框、宽度等于控件宽度、VerticalOffset -1.5 ===== -->
        <ControlTheme x:Key="MyComboBoxTheme" TargetType="ComboBox">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="1"
                                CornerRadius="3" />
                        <ToggleButton x:Name="PART_Toggle"
                                      Theme="{StaticResource MyComboBoxToggleTheme}"
                                      Margin="0,0,1.5,0"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsTabStop="False"
                                      Focusable="False"
                                      IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" />
                        <ContentControl x:Name="PART_Content"
                                        Margin="8.5,0,21.5,0"
                                        IsHitTestVisible="False"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                               MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                               MaxHeight="{TemplateBinding MaxDropDownHeight}"
                               PlacementTarget="PART_Border"
                               VerticalOffset="-1.5"
                               IsLightDismissEnabled="True">
                            <Grid>
                                <Border Background="White" CornerRadius="3" />
                                <Border x:Name="PART_DropDownBorder"
                                        Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                        BorderBrush="{TemplateBinding Foreground}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Name="PART_ItemsPresenter" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- ===== ComboBoxItem（对照 Application.xaml L447–L469）
             无高亮背景、内边距 6,4；悬停不做变色（Windows 端同样没有触发器） ===== -->
        <ControlTheme x:Key="MyComboBoxItemTheme" TargetType="ComboBoxItem">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <!-- ===== ScrollBar 拇指（对照 Application.xaml L136–L147 MyThumb）
             外层 ColorBrushSemiTransparent 底 + 内层前景色滑块，圆角 3、Margin 2 ===== -->
        <ControlTheme x:Key="MyScrollBarThumbTheme" TargetType="Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource ColorBrushSemiTransparent}">
                        <Border Background="{TemplateBinding Foreground}" CornerRadius="3" Margin="2" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- 翻页热区：Windows 用 Opacity=0 的 RepeatButton，这里用全透明模板达到同样效果（可见但无绘制） -->
        <ControlTheme x:Key="MyInvisibleButtonTheme" TargetType="RepeatButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- ===== ScrollBar（对照 Application.xaml L148–L181 MyScrollBar）
             宽 8、外层圆角 2、IsDirectionReversed、翻页按钮不可见、拇指取前景色；
             只在鼠标悬停时允许翻页（Windows 端 Track IsEnabled=IsMouseOver） ===== -->
        <ControlTheme x:Key="MyScrollBarTheme" TargetType="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Width" Value="8" />
            <Style Selector="^:vertical">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border CornerRadius="2">
                            <Track Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   IsEnabled="{TemplateBinding IsPointerOver}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton"
                                                  Theme="{StaticResource MyInvisibleButtonTheme}"
                                                  Focusable="False"
                                                  IsTabStop="False" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton"
                                                  Theme="{StaticResource MyInvisibleButtonTheme}"
                                                  Focusable="False"
                                                  IsTabStop="False" />
                                </Track.IncreaseButton>
                                <Track.Thumb>
                                    <Thumb Theme="{StaticResource MyScrollBarThumbTheme}"
                                           Foreground="{TemplateBinding Foreground}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </Style>
        </ControlTheme>

        <!-- ===== ScrollViewer（对照 Application.xaml L182–L197 MyScrollViewer）
             只做竖排、滚动条右置且贴边（Windows MyScrollViewer 不加 Margin；FullMargin 变体的 2,1,1,1
             等用到该变体的页面再补一套主题） ===== -->
        <ControlTheme x:Key="MyScrollViewerTheme" TargetType="ScrollViewer">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollContentPresenter Name="PART_ContentPresenter"
                                                Grid.Column="0"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                                VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                                HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                                VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                                ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                            <ScrollContentPresenter.GestureRecognizers>
                                <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                                         CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                                         IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}" />
                            </ScrollContentPresenter.GestureRecognizers>
                        </ScrollContentPresenter>
                        <ScrollBar Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   Grid.Column="1"
                                   Theme="{StaticResource MyScrollBarTheme}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- ===== 全局：所有 ScrollBar / ScrollViewer（含 Fluent 模板内部创建的实例）一律切到自绘主题 ===== -->
    <Style Selector="ScrollBar">
        <Setter Property="Theme" Value="{StaticResource MyScrollBarTheme}" />
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="Theme" Value="{StaticResource MyScrollViewerTheme}" />
    </Style>

    <!-- ===== TextBlock：字号 13、ColorBrush1、字符省略号、PCL 字族 ===== -->
    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
    </Style>

    <!-- ===== MyCard ===== -->
    <Style Selector="c|MyCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <!-- 外圈阴影：Margin(-3,-4,-3,-3)、圆角 5、静止不透明度 0.07 -->
                        <Border Name="PART_Chrome"
                                Margin="-3,-4,-3,-3"
                                CornerRadius="5"
                                BoxShadow="0 0 6 0 #12343d4a"
                                IsHitTestVisible="False" />
                        <!-- 卡片底：白 245/255、圆角 5 -->
                        <Border Name="PART_Bg"
                                CornerRadius="5"
                                Background="#F5FFFFFF"
                                IsHitTestVisible="False" />
                        <Grid>
                            <TextBlock Name="PART_Title"
                                       Text="{TemplateBinding Title}"
                                       Margin="15,12,0,0"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False">
                                <TextBlock.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Foreground" Duration="0:0:0.09" />
                                    </Transitions>
                                </TextBlock.Transitions>
                            </TextBlock>
                            <ContentPresenter Name="PART_Content"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="c|MyCard:pointerover /template/ Border#PART_Chrome">
        <Setter Property="BoxShadow" Value="0 0 6 0 #66343d4a" />
    </Style>
    <Style Selector="c|MyCard:pointerover /template/ TextBlock#PART_Title">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    </Style>

    <!-- ===== MyButton ===== -->
    <Style Selector="c|MyButton">
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Background="{DynamicResource ColorBrushSemiTransparent}">
                        <Border Name="PART_Fore"
                                CornerRadius="3"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                                </Transitions>
                            </Border.Transitions>
                            <TextBlock Text="{TemplateBinding Text}"
                                       Foreground="{TemplateBinding BorderBrush}"
                                       FontSize="13"
                                       TextTrimming="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="c|MyButton.highlight">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
    </Style>
    <Style Selector="c|MyButton.red">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushRedDark}" />
    </Style>
    <Style Selector="c|MyButton:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrush7}" />
    </Style>
    <Style Selector="c|MyButton.red:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushRedLight}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushRedBack}" />
    </Style>
    <Style Selector="c|MyButton:disabled">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
    </Style>
    <Style Selector="c|MyButton:pressed">
        <Setter Property="RenderTransform" Value="scale(0.955)" />
    </Style>

    <!-- ===== MyTextBox（模板精简等价版：边框 + 内容宿主） ===== -->
    <Style Selector="c|MyTextBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushBg0}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Padding" Value="5,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Name="PART_Border"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <Panel Margin="{TemplateBinding Padding}">
                            <ScrollViewer Name="PART_ContentHost">
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                                               SelectionStart="{TemplateBinding SelectionStart, Mode=TwoWay}"
                                               SelectionEnd="{TemplateBinding SelectionEnd, Mode=TwoWay}"
                                               PasswordChar="{TemplateBinding PasswordChar}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               VerticalAlignment="Center" />
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== MyComboBox（自绘 ControlTheme，1:1 照抄 Application.xaml L336–L405；配色照抄 RefreshColor） ===== -->
    <Style Selector="c|MyComboBox">
        <Setter Property="Theme" Value="{StaticResource MyComboBoxTheme}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushBg0}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <!-- 常态切换 100ms（RefreshColor 常态分支） -->
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="c|MyComboBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush4}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrush7}" />
    </Style>

    <!-- 按下 / 展开：与 Windows 端 RefreshColor 同一分支，10ms 极快切换 -->
    <Style Selector="c|MyComboBox:pressed">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrush7}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.01" />
                <BrushTransition Property="Foreground" Duration="0:0:0.01" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="c|MyComboBox:expanded">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrush7}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.01" />
                <BrushTransition Property="Foreground" Duration="0:0:0.01" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="c|MyComboBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray5}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushGray6}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="c|MyComboBoxItem">
        <Setter Property="Theme" Value="{StaticResource MyComboBoxItemTheme}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!-- ===== MyCheckBox（1:1 对齐 MyCheckBox.xaml；动画用 Transitions 近似，R10） ===== -->
    <Style Selector="c|MyCheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid MinWidth="20" MinHeight="20" Background="Transparent">
                    <Border Name="PART_ShapeBorder" Width="18" Height="18" CornerRadius="3"
                            BorderThickness="1.1" BorderBrush="{DynamicResource ColorBrush1}"
                            Background="{DynamicResource ColorBrushHalfWhite}"
                            Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                                <BrushTransition Property="Background" Duration="0:0:0.1" />
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <Path Name="PART_ShapeCheck" Width="12" Height="12" Margin="4,0,0,0"
                          Stretch="None"
                          Data="M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z"
                          Fill="{Binding #PART_ShapeBorder.BorderBrush}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5" RenderTransform="scale(0)">
                        <Path.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                            </Transitions>
                        </Path.Transitions>
                    </Path>
                    <TextBlock Name="PART_LabText" Text="{TemplateBinding Text}" Margin="26,0,0,0"
                               FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                               Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="c|MyCheckBox:checked /template/ Path#PART_ShapeCheck">
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="c|MyCheckBox:checked /template/ Border#PART_ShapeBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
    </Style>
    <Style Selector="c|MyCheckBox:pointerover /template/ Border#PART_ShapeBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="c|MyCheckBox:pointerover /template/ TextBlock#PART_LabText">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="c|MyCheckBox:disabled /template/ Border#PART_ShapeBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
    </Style>
    <Style Selector="c|MyCheckBox:disabled /template/ TextBlock#PART_LabText">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray5}" />
    </Style>
    <Style Selector="c|MyCheckBox:pressed /template/ Border#PART_ShapeBorder">
        <Setter Property="Background" Value="{DynamicResource ColorBrushBg1}" />
        <Setter Property="RenderTransform" Value="scale(0.917)" />
    </Style>

    <!-- ===== MyHint（1:1 对齐 MyHint.xaml；关闭记忆与收高动画未移植，R11） ===== -->
    <Style Selector="c|MyHint">
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="PART_LabText" Text="{TemplateBinding Text}" LineHeight="16"
                                   Margin="0,0,0,-1" Padding="12,9" TextWrapping="Wrap"
                                   FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                   Foreground="{TemplateBinding Foreground}" />
                        <c:MyIconButton Name="PART_BtnClose" Grid.Column="1" Width="20" Height="20"
                                        Margin="0,0,8,0" VerticalAlignment="Center" IconTheme="Custom"
                                        Foreground="{TemplateBinding Foreground}"
                                        Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                                        IsVisible="{TemplateBinding CanClose}" ToolTip.Tip="不再提示" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ===== MyListItem（1:1 对齐 MyListItem.xaml(.vb)）=====
         RectBack / RectCheck / Logo / 标题 / 按钮由控件代码按 WPF 顺序创建，此处只按 Name 命中配色。 -->
    <Style Selector="c|MyListItem">
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="c|MyListItem:checked">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    </Style>
    <!-- 高 &lt; 40 的紧凑档选中用 ColorBrush3（MyListItem.vb 中的分支） -->
    <Style Selector="c|MyListItem:checked:small">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="c|MyListItem TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
    </Style>
    <Style Selector="c|MyListItem > Border#PART_RectBack">
        <Setter Property="Background" Value="{DynamicResource ColorBrush7}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush6}" />
    </Style>
    <Style Selector="c|MyListItem:pointerover > Border#PART_RectBack">
        <Setter Property="Background" Value="{DynamicResource ColorBrushBg1}" />
    </Style>
    <Style Selector="c|MyListItem:down > Border#PART_RectBack">
        <Setter Property="Background" Value="{DynamicResource ColorBrush6}" />
    </Style>
    <Style Selector="c|MyListItem > Border#PART_RectCheck">
        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
    </Style>

    <!-- ===== MyLoading（1:1 对齐 MyLoading.xaml；镐子摆动改为循环旋转近似，R10） ===== -->
    <Style Selector="c|MyLoading">
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="FontFamily" Value="{DynamicResource PclFont}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{TemplateBinding Background}" RowDefinitions="*,Auto,Auto,*">
                    <Grid Grid.Row="1" Width="60" Height="47" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Path Name="PART_PathPickaxe" Stretch="Uniform" Height="35" Margin="10,6,0,0"
                              StrokeThickness="2" Stroke="{TemplateBinding Foreground}"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              RenderTransformOrigin="0.5,0.5" RenderTransform="rotate(55deg)"
                              Data="M 963.6 858.2 410.816 305.504 C 508.116 213.304 609.204 196.8 711.104 128.6 837.11367 49.573762 879.34045 50.334062 751.5 49.5 611.3 52 471.8 96.2 353.3 182.4 309.8 155.7 252.1 161.2 214.5 198.9 176.9 236.6 171.3 294.2 198 337.7 111.8 456.3 67.6 595.8 65.1 735.9 63.315254 883.82034 65.077966 837.29308 144.2 695.488 212.4 593.588 228.888 492.4 321.088 395.2 L 873.9 948 c 0.60001 0.59999 1.6 0.6 2.2 0 l 87.5 -87.5 c 0.6 -0.7 0.6 -1.6 0 -2.3 z" />
                        <Path Name="PART_PathLeft" Opacity="0" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                              Width="3" Height="5" Data="M0,0L2,0L1,4" Margin="7,41,0,0"
                              RenderTransformOrigin="0.5,0.5" RenderTransform="rotate(-45deg)"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Name="PART_PathRight" Opacity="0" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                              Width="3" Height="5" Data="M0,0L2,0L1,4" Margin="14,41,0,0"
                              RenderTransformOrigin="0.5,0.5" RenderTransform="rotate(45deg)"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Name="PART_PathError" Opacity="0" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                              Width="17" Height="17" Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                              Margin="4,23,0,0" RenderTransformOrigin="0.5,0.5" RenderTransform="scale(0.6)"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Width="25" Height="2" Fill="{TemplateBinding Foreground}"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Name="PART_LabText" Grid.Row="2" Text="加载中" FontSize="16" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top"
                               FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="c|MyLoading /template/ Path#PART_PathPickaxe">
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="INFINITE" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="rotate(35deg)" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="rotate(75deg)" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ===== MyIconButton（1:1 对齐 MyIconButton.xaml；主题色映射待核对，R12） ===== -->
    <Style Selector="c|MyIconButton">
        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="1000" Background="{TemplateBinding Background}" BorderThickness="0.001">
                    <Border Name="PART_PanBack" CornerRadius="1000" BorderThickness="0.001"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                            </Transitions>
                        </Border.Transitions>
                        <Path Name="PART_Path" Stretch="Uniform" Margin="5" RenderTransformOrigin="0.5,0.5"
                              Fill="{TemplateBinding Foreground}" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="c|MyIconButton:pressed /template/ Border#PART_PanBack">
        <Setter Property="RenderTransform" Value="scale(0.8)" />
    </Style>

    <!-- ===== MyRadioButton（1:1 对齐 MyRadioButton.xaml；状态色照抄 .xaml.vb L233–L254 的 ColorState.White 分支） ===== -->
    <Style Selector="c|MyRadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushWhite}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_PanBack" Background="{TemplateBinding Background}" CornerRadius="13.5"
                        MinHeight="27" MaxHeight="27" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Name="PART_Path" Margin="12,0,0,0" Stretch="Uniform" MaxHeight="16" MaxWidth="16"
                              VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"
                              RenderTransformOrigin="0.5,0.5" />
                        <TextBlock Name="PART_Text" VerticalAlignment="Center" Margin="8,0,12,0" FontSize="13"
                                   Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Text}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="c|MyRadioButton:pointerover">
        <Setter Property="Background" Value="#32eaf2fe" />
    </Style>

    <Style Selector="c|MyRadioButton:pressed">
        <Setter Property="Background" Value="#78eaf2fe" />
    </Style>

    <!-- 选中态写在悬停/按下之后：同优先级下后写的样式生效（白底 + ColorBrush3 字/图标） -->
    <Style Selector="c|MyRadioButton:checked">
        <Setter Property="Background" Value="{DynamicResource ColorBrushWhite}" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
    </Style>

</Styles>
