<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PCL.Desktop.Linux.Controls"
             x:Class="PCL.Desktop.Linux.Views.PageInstanceOverallView">

    <!--
      1:1 对照基准：pcl-next/Pages/PageInstance/PageInstanceOverall.xaml（88 行）
      外层：MyPageRight PanScroll="PanBack" + Grid.IsSharedSizeScope → MyScrollViewer → StackPanel Margin 25,10
      卡片：版本头卡（PanDisplayItem 由运行期注入）/ 个性化 / 快捷方式 / 高级管理
      静态默认（R47）：无实例数据，头卡为空；「Mod 文件夹」按 Instance.Modable=False 隐藏；
      「加入收藏夹」保持未收藏文案；图标 / 分类下拉的选中项与所有按钮动作未接入。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <!-- 版本头卡：Windows 在此注入 Instance.ToListItem()（R47） -->
            <c:MyCard Margin="0,15" Title="">
                <Grid Margin="10,7" x:Name="PanDisplayItem" MinHeight="42" />
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="个性化" x:Name="PanDisplay">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanDisplayIcon" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="图标" Margin="0,0,25,0" />
                        <c:MyComboBox Grid.Column="1" x:Name="ComboDisplayLogo">
                            <c:MyComboBoxItem Content="自动" IsSelected="True" Tag="" />
                            <c:MyComboBoxItem Content="自定义..." x:Name="ItemDisplayLogoCustom" Tag="PCL\Logo.png" />
                            <c:MyComboBoxItem Content="圆石" Tag="pack://application:,,,/images/Blocks/CobbleStone.png" />
                            <c:MyComboBoxItem Content="命令方块" Tag="pack://application:,,,/images/Blocks/CommandBlock.png" />
                            <c:MyComboBoxItem Content="金块" Tag="pack://application:,,,/images/Blocks/GoldBlock.png" />
                            <c:MyComboBoxItem Content="草方块" Tag="pack://application:,,,/images/Blocks/Grass.png" />
                            <c:MyComboBoxItem Content="土径" Tag="pack://application:,,,/images/Blocks/GrassPath.png" />
                            <c:MyComboBoxItem Content="铁砧" Tag="pack://application:,,,/images/Blocks/Anvil.png" />
                            <c:MyComboBoxItem Content="红石块" Tag="pack://application:,,,/images/Blocks/RedstoneBlock.png" />
                            <c:MyComboBoxItem Content="红石灯（开）" Tag="pack://application:,,,/images/Blocks/RedstoneLampOn.png" />
                            <c:MyComboBoxItem Content="红石灯（关）" Tag="pack://application:,,,/images/Blocks/RedstoneLampOff.png" />
                            <c:MyComboBoxItem Content="鸡蛋" Tag="pack://application:,,,/images/Blocks/Egg.png" />
                            <c:MyComboBoxItem Content="布料（Fabric）" Tag="pack://application:,,,/images/Blocks/Fabric.png" />
                            <c:MyComboBoxItem Content="狐狸（NeoForge）" Tag="pack://application:,,,/images/Blocks/NeoForge.png" />
                        </c:MyComboBox>
                        <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left" Text="分类" Margin="0,0,25,0" />
                        <c:MyComboBox Grid.Column="1" Grid.Row="2" x:Name="ComboDisplayType">
                            <c:MyComboBoxItem Content="自动" IsSelected="True" />
                            <c:MyComboBoxItem Content="从版本列表中隐藏" ToolTip.Tip="该版本默认将不会在版本列表中显示。&#10;在版本列表页面按下 F11，即可查看所有隐藏的版本。" />
                            <c:MyComboBoxItem Content="可安装 Mod 的版本" />
                            <c:MyComboBoxItem Content="常规版本" />
                            <c:MyComboBoxItem Content="不常用版本" />
                            <c:MyComboBoxItem Content="愚人节版本" />
                        </c:MyComboBox>
                    </Grid>
                    <Grid Margin="0,15,0,7" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <c:MyButton x:Name="BtnDisplayRename" Text="修改版本名" MinWidth="140" Padding="13,0" Margin="0,0,20,0" />
                        <c:MyButton x:Name="BtnDisplayDesc" Text="修改版本描述" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="1" />
                        <c:MyButton x:Name="BtnDisplayStar" Text="加入收藏夹" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="2" />
                    </Grid>
                </StackPanel>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="快捷方式" x:Name="PanFolder">
                <WrapPanel Margin="25,30,25,20">
                    <c:MyButton x:Name="BtnFolderVersion" Text="版本文件夹" MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35" />
                    <c:MyButton x:Name="BtnFolderSaves" Text="存档文件夹" MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35" />
                    <c:MyButton x:Name="BtnFolderMods" Text="Mod 文件夹" MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35" IsVisible="False" />
                    <c:MyButton x:Name="BtnFolderScreen" Text="截图文件夹" MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35" />
                </WrapPanel>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="高级管理" x:Name="PanManage">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,2,0,7" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <c:MyButton x:Name="BtnManageScript" Text="导出启动脚本" MinWidth="140" Padding="13,0" Margin="0,0,20,0" />
                        <c:MyButton x:Name="BtnManageCheck" Text="补全文件" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="1"
                                    ToolTip.Tip="校验版本依赖文件是否完整，并重新下载 Assets 索引与缺失、校验失败的文件。&#10;若游戏缺失音效，请尝试此项。" />
                        <c:MyButton x:Name="BtnManageDelete" Text="删除版本" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="2" ColorType="Red" />
                    </Grid>
                </StackPanel>
            </c:MyCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
