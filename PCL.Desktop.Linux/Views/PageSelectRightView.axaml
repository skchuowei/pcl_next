<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PCL.Desktop.Linux.Controls"
             x:Class="PCL.Desktop.Linux.Views.PageSelectRightView">

    <!--
      1:1 对照基准：pcl-next/Pages/PageSelectRight.xaml（全文 25 行）
      · 根 MyPageRight PanScroll="PanBack"（Linux 右页宿主未移植，见 R22）
      · PanAllBack：MyScrollViewer + StackPanel PanMain Margin 25,25,25,10（版本卡片由运行期注入）
      · PanEmpty：居中 MyCard、Margin 40、内容 StackPanel Margin 20,17；
        标题「无可用版本」19 号 ColorBrush3；2 高分隔线；两行说明文字；
        `BtnEmptyDownload` 高 35、MinWidth 140、Padding 13,0、Highlight、「下载游戏」、Margin 0,10,0,0
      · PanLoad：居中 MyCard + MyLoading「正在获取版本列表」Margin 20,20,20,17
      静态初始态（R26）：Linux 侧无实例列表服务，按 Windows「加载完成且无版本」分支
      （`PageSelectRight.xaml.vb` L98–L109）固定为 PanEmpty 可见、PanAllBack/PanLoad 隐藏。
    -->

    <Grid>
        <Grid x:Name="PanAllBack" IsVisible="False">
            <ScrollViewer x:Name="PanBack"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanMain" Margin="25,25,25,10" />
            </ScrollViewer>
        </Grid>

        <c:MyCard x:Name="PanEmpty"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <StackPanel Margin="20,17">
                <TextBlock x:Name="LabEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center"
                           Text="无可用版本" FontSize="19"
                           Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle HorizontalAlignment="Stretch" Height="2"
                           Fill="{DynamicResource ColorBrush3}" />
                <TextBlock x:Name="LabEmptyContent" Margin="10,15,10,5" TextWrapping="Wrap"
                           Text="未找到任何版本的游戏，请先下载任意版本的游戏。&#xa;若有已存在的游戏，请在左边的列表中选择“添加文件夹”，选择 .minecraft 文件夹将其导入。" />
                <c:MyButton x:Name="BtnEmptyDownload" Height="35" HorizontalAlignment="Center"
                            MinWidth="140" Text="下载游戏" Margin="0,10,0,0" Padding="13,0"
                            ColorType="Highlight" />
            </StackPanel>
        </c:MyCard>

        <c:MyCard x:Name="PanLoad"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                  IsVisible="False">
            <c:MyLoading x:Name="Load" Text="正在获取版本列表"
                         Margin="20,20,20,17"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False" />
        </c:MyCard>
    </Grid>
</UserControl>
