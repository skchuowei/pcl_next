<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PCL.Desktop.Linux.Controls"
             x:Class="PCL.Desktop.Linux.Views.PageResourceView">

    <!--
      1:1 对照基准：pcl-next/Pages/PageDownload/Resource/PageResource.xaml（全文 96 行）
      外层：MyScrollViewer(Auto/Disabled) → StackPanel Margin 25
        · MyCard「搜索XXX」Margin 0,0,0,15 → StackPanel Margin 25,40,25,15
          - 搜索条件 Grid：6 列（Auto / 1.3* / 1.2* / 50 / Auto / 1*）、3 行（28/9/28）
            名称（TextBox 跨 2 列）/ 来源（下拉）/ 版本（可用下拉）/ 加载器（默认隐藏）/ 类型（下拉）
          - 按钮行 Grid Margin 0,4,0,6 Height 35：搜索（Highlight）/ 重置条件 / 安装已有整合包（仅整合包可见）
        · PanContent：两条提示条（默认隐藏）+ 结果卡（空）+ 分页卡
        · PanLoad：加载卡片（静态无加载器，保持隐藏）

      类型差异（对应 PageDownloadMod/Pack/DataPack/ResourcePack/Shader.xaml 五页）：
      标题、加载文案与「类型」下拉项由 `ResourcePageKind` 在代码侧按原 XAML 逐项生成，
      布局与其余控件完全共用；五个包装页不再重复同一份布局。

      差异登记：
      · R40 —— 资源搜索服务未接入：结果列表为空、分页固定第 1 页且翻页按钮禁用；
        搜索 / 重置条件 / 安装已有整合包 / 翻页均为空操作；HintSource / HintError 保持隐藏
        （原逻辑：搜索成功后隐藏错误条，来源不可用时才显示蓝色提示）
      · R41 —— WPF 版本下拉的 `IsEditable="True"`（可自行输入版本号）在 Avalonia ComboBox
        无等价属性，退化为普通下拉；`IsTextSearchEnabled` 亦未设置
      · R42 —— 资源条目 `MyResourceItem` 与资源详情页 `PageDownloadCompDetail` 未移植
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="25">
            <c:MyCard Title="搜索" Margin="0,0,0,15" x:Name="PanAlways">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,0,0,11" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="名称" Margin="0,0,18,0" />
                        <c:MyTextBox x:Name="TextSearchName" Grid.Column="1" Grid.ColumnSpan="2" />
                        <TextBlock VerticalAlignment="Center" Grid.Column="4" HorizontalAlignment="Left"
                                   Text="来源" Margin="0,0,18,0" />
                        <c:MyComboBox x:Name="ComboSearchSource" Grid.Column="5" SelectedIndex="0">
                            <c:MyComboBoxItem Content="全部" Tag="3" />
                            <c:MyComboBoxItem Content="CurseForge" Tag="1" />
                            <c:MyComboBoxItem Content="Modrinth" Tag="2" />
                        </c:MyComboBox>
                        <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left"
                                   Text="版本" Margin="0,0,18,0" />
                        <c:MyComboBox x:Name="TextSearchVersion" Grid.Row="2" Grid.Column="1"
                                      Grid.ColumnSpan="2" SelectedIndex="0">
                            <c:MyComboBoxItem Content="全部 (也可自行输入)" />
                            <c:MyComboBoxItem Content="26.2" />
                            <c:MyComboBoxItem Content="26.1" />
                            <c:MyComboBoxItem Content="1.21.11" />
                            <c:MyComboBoxItem Content="1.21.8" />
                            <c:MyComboBoxItem Content="1.21.4" />
                            <c:MyComboBoxItem Content="1.21.1" />
                            <c:MyComboBoxItem Content="1.20.1" />
                            <c:MyComboBoxItem Content="1.19.2" />
                            <c:MyComboBoxItem Content="1.18.2" />
                            <c:MyComboBoxItem Content="1.16.5" />
                            <c:MyComboBoxItem Content="1.12.2" />
                            <c:MyComboBoxItem Content="1.7.10" />
                        </c:MyComboBox>
                        <c:MyComboBox x:Name="ComboSearchLoader" IsVisible="False" Grid.Row="2"
                                      Grid.Column="2" Margin="10,0,0,0" SelectedIndex="0">
                            <c:MyComboBoxItem Content="任意 Mod 加载器" Tag="0" />
                            <c:MyComboBoxItem Content="Forge" Tag="1" />
                            <c:MyComboBoxItem Content="NeoForge" Tag="16" />
                            <c:MyComboBoxItem Content="Fabric" Tag="4" />
                            <c:MyComboBoxItem Content="LiteLoader" Tag="2" />
                        </c:MyComboBox>
                        <TextBlock VerticalAlignment="Center" Grid.Column="4" Grid.Row="2"
                                   HorizontalAlignment="Left" Text="类型" Margin="0,0,18,0" />
                        <c:MyComboBox x:Name="ComboSearchTag" Grid.Column="5" Grid.Row="2" />
                    </Grid>
                    <Grid Margin="0,4,0,6" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <c:MyButton x:Name="BtnSearchRun" Text="搜索" MinWidth="140" Padding="13,0"
                                    Margin="0,0,20,0" ColorType="Highlight" />
                        <c:MyButton x:Name="BtnSearchReset" Text="重置条件" MinWidth="140"
                                    Padding="13,0" Margin="0,0,20,0" Grid.Column="1" />
                        <c:MyButton x:Name="BtnSearchInstallModPack" Text="安装已有整合包" MinWidth="140"
                                    Padding="13,0" Margin="0,0,20,0" Grid.Column="2" IsVisible="False"
                                    ToolTip.Tip="在当前选择的 Minecraft 文件夹下安装整合包" />
                    </Grid>
                </StackPanel>
            </c:MyCard>
            <StackPanel x:Name="PanContent">
                <c:MyHint x:Name="HintSource" HasBorder="True" HintTheme="Blue" IsVisible="False"
                          Margin="0,0,0,15" />
                <c:MyHint x:Name="HintError" HasBorder="True" HintTheme="Yellow" IsVisible="False"
                          Margin="0,0,0,15"
                          Text="无法连接到 Modrinth，所以目前仅显示了来自 CurseForge 的内容，搜索结果可能不全。&#xa;请稍后再试，或使用 VPN 改善网络环境。" />
                <c:MyCard x:Name="CardProjects">
                    <StackPanel x:Name="PanProjects" Margin="12" />
                </c:MyCard>
                <c:MyCard Margin="0,15,0,0" x:Name="CardPages" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Height="23" Margin="10,7">
                        <c:MyIconButton x:Name="BtnPageFirst" IsEnabled="False" Opacity="0.2"
                                        Margin="0,0.5,5,0.5"
                                        Logo="M496.213333 329.856L315.306667 510.848l180.992 181.077333a42.666667 42.666667 0 1 1-60.330667 60.330667l-211.2-211.2a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.373333-27.648l211.2-211.2a42.666667 42.666667 0 0 1 60.373334 60.330667z m298.666667 0l-180.949333 180.992 180.992 181.077333a42.666667 42.666667 0 1 1-60.330667 60.330667l-211.2-211.2a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.373333-27.648l211.2-211.2a42.666667 42.666667 0 0 1 60.373334 60.330667z" />
                        <c:MyIconButton x:Name="BtnPageLeft" IsEnabled="False" Opacity="0.2"
                                        Margin="0,0,5,0"
                                        Logo="M650.752 278.357333l-241.322667 241.365334 241.322667 241.365333a42.666667 42.666667 0 1 1-60.330667 60.330667l-271.530666-271.530667a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.416-27.648l271.530666-271.530666a42.666667 42.666667 0 0 1 60.330667 60.330666z" />
                        <TextBlock x:Name="LabPage" Text="1" Margin="8,0,13,0" FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <c:MyIconButton x:Name="BtnPageRight" Margin="0,0,30,0"
                                        Logo="M404.309333 278.357333l241.322667 241.365334-241.322667 241.365333a42.666667 42.666667 0 1 0 60.330667 60.330667l271.530667-271.530667a42.453333 42.453333 0 0 0 11.818666-22.613333l0.597334-5.034667v-5.034667a42.496 42.496 0 0 0-12.416-27.648L464.64 218.026667a42.666667 42.666667 0 0 0-60.330667 60.330666z" />
                    </StackPanel>
                </c:MyCard>
            </StackPanel>
            <c:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="PanLoad"
                      IsVisible="False" Margin="40,50">
                <c:MyLoading Text="正在获取列表" Margin="20,20,20,17" x:Name="Load"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             ShowProgress="True" />
            </c:MyCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
