<c:MyPageLeft xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="using:PCL.Desktop.Linux.Controls"
              x:Class="PCL.Desktop.Linux.Views.PageLaunchLeftView"
              Width="300">

    <!--
      1:1 对照基准：pcl-next/Pages/PageLaunch/PageLaunchLeft.xaml（全文 156 行）
      布局逐项照抄：
      · 根 MyPageLeft 宽 300（无 AnimatedControl → 整页 0.96→1 缩放，MyPageLeft.vb L16–L28）
      · PanInput 行 Auto / * / Auto / Auto / 20；列 Auto / 20 / 1* / Auto / 10
      · BtnVersion（行3列2，高35，Margin 0,10,10,0）、BtnMore（行3列3，初始 Collapsed）
      · PanLogin（跨5列、行1、Margin 20,0，登录区运行期注入）
      · PanTypeOne（跨5列，Margin 20,24,20,-4）：半透明胶囊 + 16×16 图标（Scale 1.05）+ 14 号主题色文字
      · PanType（跨5列，Margin 20,22,20,0，初始 Collapsed）：正版 / 离线两个 MyRadioButton
      · BtnLaunch（行2、跨5列，高54、Margin 20,0、Highlight、Padding 30,0,30,15）
      · LabVersion（同格底部，Margin 35,0,35,10、11 号、ColorBrushGray3、字符省略号）
      · PanLaunching（初始 Collapsed + Opacity 0）：5 行网格、MyLoading 高 50、
        标题/版本名 20/13.5 号主题色 + -3° 斜切、进度条 4 高（69.28*/30.72*）、
        四行信息（当前步骤/登录方式/启动进度/下载速度）、提示气泡、取消按钮（行4、高35、Margin 20,0,20,20）

      静态初始态（R24）：Linux 侧尚无实例列表 / 启动服务，按 Windows「加载完成但无可用版本」的
      Case 2 呈现（`PageLaunchLeft.xaml.vb` L671–L677）：按钮「下载游戏」可点、版本按钮可用、
      LabVersion「未找到可用的游戏版本」。不是新行为，只是把运行期状态定在该分支。

      差异登记：
      · R24 —— 同上（无实例/启动服务 → 固定 Case 2 静态态）
      · R25 —— WPF `DropShadowBitmapEffect`（L85–L87）、`CombinedGeometry` 提示气泡挖孔裁剪
        （L137–L147）、`LabVersion` 对 BtnLaunch 的 `RealRenderTransform` 缩放绑定（L66–L70）、
        `MyButton.TextPadding`（BtnMore，L28）在 Avalonia 无等价物，均未复刻；
        不影响几何尺寸与文案
    -->

    <Grid x:Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>

        <c:MyButton Grid.Row="3" Grid.Column="2" x:Name="BtnVersion"
                    Height="35" Margin="0,10,10,0" Text="版本选择" />
        <c:MyButton Grid.Row="3" Grid.Column="3" x:Name="BtnMore"
                    IsVisible="False" Height="35" Margin="0,10,10,0" Text="版本设置" />

        <Grid Grid.ColumnSpan="5" Grid.Row="1" Margin="20,0" VerticalAlignment="Center" x:Name="PanLogin" />

        <Grid Grid.ColumnSpan="5" Margin="20,24,20,-4" x:Name="PanTypeOne">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ColorBrushSemiTransparent}"
                    CornerRadius="13" MinHeight="27" MaxHeight="27">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="PathTypeOne"
                          HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5"
                          Margin="12,0,0,0" Stretch="Uniform"
                          Fill="{DynamicResource ColorBrush3}"
                          MaxHeight="16" MaxWidth="16" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock x:Name="LabTypeOne" Text="" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrush3}" Margin="15,0,12,0"
                               Grid.ColumnSpan="2" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="5" Margin="20,22,20,0" x:Name="PanType" IsVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <c:MyRadioButton x:Name="RadioLoginType5" Grid.Column="2" Text="正版" Margin="4,0" LogoScale="1"
                             Logo="M511.488256 95.184408c35.310345 22.516742 95.184408 55.78011 167.34033 84.437781 75.738131 29.681159 148.405797 40.93953 191.392304 45.033483v353.615193c0 73.691154-50.662669 164.781609-136.123938 244.101949C649.65917 901.181409 558.568716 942.12094 512 942.12094c-46.568716 0-137.65917-40.93953-222.096952-119.748126C204.441779 742.54073 153.77911 651.450275 153.77911 577.247376v-353.103448c42.474763-4.093953 116.165917-15.352324 191.904048-45.545227 75.226387-30.192904 133.565217-63.456272 165.805098-83.414293M512 0c-4.093953 0-8.187906 1.535232-11.258371 3.582209l-14.84058 10.234882c-1.023488 0.511744-67.550225 47.592204-170.410794 88.531735-100.813593 39.916042-198.556722 41.963018-199.58021 41.963018l-25.075462 0.511744c-10.746627 0.511744-18.934533 8.187906-18.934533 18.422789v414.000999c0 216.97951 286.064968 446.24088 440.09995 446.24088s440.09995-229.261369 440.09995-445.729136V163.758121c0-10.234883-8.69965-18.422789-18.934533-18.422789l-24.563718-0.511744c-1.023488 0-98.766617-2.046977-199.58021-41.963018-103.372314-40.93953-170.410795-88.01999-170.922538-88.531734L523.258371 3.582209c-3.070465-2.558721-7.164418-3.582209-11.258371-3.582209z M743.308346 410.930535l-260.477761 260.477761c-15.864068 15.864068-41.963018 15.864068-57.827087 0l-144.823588-144.823588c-15.864068-15.864068-15.864068-41.963018 0-57.827087 8.187906-8.187906 18.422789-11.770115 29.169415-11.770115 10.234883 0 20.981509 4.093953 29.169416 11.770115l115.654173 115.654173L685.993003 352.591704c15.864068-15.864068 41.963018-15.864068 57.827087 0 15.352324 16.375812 15.352324 42.474763-0.511744 58.338831z" />
            <c:MyRadioButton x:Name="RadioLoginType0" Grid.Column="3" Text="离线" Margin="4,0" LogoScale="0.85"
                             Logo="M533.293176 788.841412a60.235294 60.235294 0 1 1 85.202824 85.202823l-42.616471 42.586353c-129.355294 129.385412-339.124706 129.385412-468.510117 0-129.385412-129.385412-129.385412-339.124706 0-468.510117l42.586353-42.616471a60.235294 60.235294 0 1 1 85.202823 85.202824l-42.61647 42.586352a210.823529 210.823529 0 1 0 298.164706 298.164706l42.586352-42.61647z m255.548236-255.548236l42.61647-42.586352a210.823529 210.823529 0 1 0-298.164706-298.164706l-42.586352 42.61647a60.235294 60.235294 0 1 1-85.202824-85.202823l42.616471-42.586353c129.355294-129.385412 339.124706-129.385412 468.510117 0 129.385412 129.385412 129.385412 339.124706 0 468.510117l-42.586353 42.616471a60.235294 60.235294 0 1 1-85.202823-85.202824zM192.542118 192.542118a60.235294 60.235294 0 0 1 85.202823 0l553.712941 553.712941a60.235294 60.235294 0 0 1-85.202823 85.202823L192.542118 277.744941a60.235294 60.235294 0 0 1 0-85.202823z" />
        </Grid>

        <Grid Grid.ColumnSpan="5" Grid.Row="2" RenderTransformOrigin="0.5,0.5">
            <c:MyButton x:Name="BtnLaunch" Height="54" Margin="20,0" Text="下载游戏"
                        ColorType="Highlight" Padding="30,0,30,15" />
            <TextBlock x:Name="LabVersion" Text="未找到可用的游戏版本"
                       Margin="35,0,35,10" IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontSize="11"
                       Foreground="{DynamicResource ColorBrushGray3}"
                       RenderTransformOrigin="0.5,-0.2" />
        </Grid>
    </Grid>

    <Grid x:Name="PanLaunching" RenderTransformOrigin="0.5,0.5" IsVisible="False" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" RenderTransformOrigin="0.5,0.5" Margin="0,-7,0,0">
            <c:MyLoading x:Name="LoadLaunching" Height="50" Margin="0,10,0,5" />
            <TextBlock x:Name="LabLaunchingTitle" Margin="15,10,15,0" Text="正在启动游戏"
                       HorizontalAlignment="Center" FontSize="20"
                       Foreground="{DynamicResource ColorBrush3}">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="LabLaunchingName" Margin="40,5,40,0" FontSize="13.5"
                       Text="Forge 1.12.2-15.8.0.1560" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ColorBrush3}" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid Height="4" Margin="30,12,30,27">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="69.28*" />
                    <ColumnDefinition Width="30.72*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="{DynamicResource ColorObject4}" Offset="0" />
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.6" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrush6}" Opacity="0.6" />
            </Grid>

            <Grid HorizontalAlignment="Center" x:Name="PanLaunchingInfo">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="当前步骤" Grid.Row="0" Grid.Column="1"
                           HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="下载支持" Grid.Row="0" Grid.Column="3"
                           HorizontalAlignment="Left" x:Name="LabLaunchingStage" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="登录方式" Grid.Row="1" Grid.Column="1"
                           HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="正版登录" Grid.Row="1" Grid.Column="3"
                           HorizontalAlignment="Left" x:Name="LabLaunchingMethod" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="启动进度" Grid.Row="2" Grid.Column="1"
                           HorizontalAlignment="Right" Opacity="0.5" x:Name="LabLaunchingProgressLeft" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="69.28 %" Grid.Row="2" Grid.Column="3"
                           HorizontalAlignment="Left" x:Name="LabLaunchingProgress" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="下载速度" Grid.Row="3" Grid.Column="1"
                           HorizontalAlignment="Right" Opacity="0" x:Name="LabLaunchingDownloadLeft"
                           IsVisible="False" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="5.2 M/s" Grid.Row="3" Grid.Column="3"
                           HorizontalAlignment="Left" x:Name="LabLaunchingDownload"
                           Opacity="0" IsVisible="False" />
                <Grid x:Name="PanLaunchingHint" HorizontalAlignment="Center"
                      Grid.Row="2" Grid.ColumnSpan="5" Grid.RowSpan="2"
                      Width="260" Margin="0,16,0,2" IsVisible="False" Opacity="0">
                    <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="3"
                            BorderBrush="{DynamicResource ColorBrushGray1}" Opacity="0.5" />
                    <TextBlock FontSize="12.5" Text="你知道吗" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Foreground="{DynamicResource ColorBrushGray1}" Opacity="0.5" />
                    <TextBlock x:Name="LabLaunchingHint" FontSize="12.5"
                               Text="这是一段测试用的小提示文本，它应该足够长以让它有两行。"
                               Margin="11,21,11,10" TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </Grid>
            </Grid>
        </StackPanel>

        <c:MyButton Grid.Row="4" x:Name="BtnCancel" Height="35" Margin="20,0,20,20"
                    VerticalAlignment="Bottom" Text="取消" />
    </Grid>
</c:MyPageLeft>
