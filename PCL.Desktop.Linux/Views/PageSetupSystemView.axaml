<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PCL.Desktop.Linux.Controls"
             x:Class="PCL.Desktop.Linux.Views.PageSetupSystemView">

    <!--
      1:1 对照基准：pcl-next/Pages/PageSetup/PageSetupSystem.xaml（全文 205 行）
      外层：MyPageRight PanScroll="PanBack" → MyScrollViewer(Auto/Disabled) → StackPanel Margin 25,10
      四张可见卡片：下载 / 社区资源 / 辅助功能 / 启动器，外加默认折叠的「调试选项」（CanSwap + IsSwapped）

      静态初值取自 Settings.vb 的默认值（不是 XAML 设计值）：
      · ToolDownloadSource = 1 → 下载源第 2 项「优先使用官方源，在加载缓慢时换用镜像源」
      · ToolDownloadVersion = 1 → 版本列表源第 2 项（同文案）
      · ToolDownloadThread = 63 → 最大线程数滑块 Value 63（MaxValue 255，XAML 亦写 63）
      · ToolDownloadSpeed = 42 → 速度限制滑块 Value 42（MaxValue 42，即「无限制」）
      · ToolDownloadMod = 2 → 社区资源来源「尽量使用官方源」
      · ToolDownloadTranslateV2 = 1 → 文件名格式第 2 项「[机械动力] create-1.21.1-6.0.4」
      · ToolModLocalNameStyle = 0 → Mod 管理样式第 1 项「标题显示译名，详情显示文件名」
      · ToolUpdateRelease / ToolUpdateSnapshot = False → 两个更新提示复选框不勾
      · ToolHelpChinese = True → 「自动设置为中文」勾选
      · SystemSystemUpdate / SystemSystemActivity = 0 → 两个下拉均为第 1 项
      · SystemSystemCache = "" → 缓存文件夹输入框为空（HintText「默认」）
      · SystemDebugAnim = 9 → 动画速度滑块 Value 9（MaxValue 30）
      · SystemDebugSkipCopy / SystemDebugMode / SystemDebugDelay = False → 调试三项不勾
      · ChannelIsOfficial = False（Dev 渠道，`PageSetupSystem.xaml.vb` L9–L14）→ PanDonate 可见，
        ItemSystemUpdateDownload 文案改为「在有新版本时自动下载（更新非正式版前需要先输入土豆码）」

      差异登记：
      · R33 —— SettingService 键值绑定未接入，本页为静态默认态；文案 / ToolTip 逐字保留
      · R34 —— 交互未接入：检查更新 / 导出设置 / 导入设置 / 复制识别码 / 输入土豆码 均为空操作；
        线程数 > 100 的警告弹窗、两个下拉选到末项时的确认回滚、调试模式切换提示均未实现
      · R35 —— MyTextBox 校验规则（ValidateNullable / ValidateFolderPath）未接入，仅保留 HintText 与 ToolTip
      · R27 —— MySlider 无数值提示 Popup（线程数 v+1、限速档位文案、动画速度倍率文案未显示）
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,10">

            <c:MyCard Margin="0,15" Title="下载">
                <StackPanel Margin="25,37,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="文件下载源" Margin="0,0,25,0" />
                        <c:MyComboBox x:Name="ComboDownloadSource" Grid.ColumnSpan="2" Grid.Column="1"
                                      SelectedIndex="1">
                            <c:MyComboBoxItem Content="尽量使用镜像源" />
                            <c:MyComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" />
                            <c:MyComboBoxItem Content="尽量使用官方源" />
                        </c:MyComboBox>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="版本列表源" Margin="0,0,25,0" Grid.Row="2" />
                        <c:MyComboBox x:Name="ComboDownloadVersion" Grid.ColumnSpan="2" Grid.Column="1"
                                      Grid.Row="2" SelectedIndex="1">
                            <c:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚刚更新的版本）" />
                            <c:MyComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" />
                            <c:MyComboBoxItem Content="尽量使用官方源" />
                        </c:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="最大线程数" Margin="0,0,25,0" />
                        <c:MySlider x:Name="SliderDownloadThread" Grid.Row="4" MaxValue="255" Value="63"
                                    Grid.Column="1"
                                    ToolTip.Tip="线程数越多，限速的文件下载越快，但过高的线程数会造成下载时非常严重的卡顿。&#xa;一般而言，64 线程已可以保证足够的下载速度。" />
                        <TextBlock VerticalAlignment="Center" Grid.Row="5" HorizontalAlignment="Left"
                                   Text="速度限制" Margin="0,0,25,0" />
                        <c:MySlider x:Name="SliderDownloadSpeed" Grid.Row="5" MaxValue="42" Value="42"
                                    Grid.Column="1"
                                    ToolTip.Tip="设置下载的速度上限，以避免在下载时导致其他需要联网的程序卡死" />
                        <TextBlock VerticalAlignment="Top" Grid.Row="6" HorizontalAlignment="Left"
                                   Text="目标文件夹" Margin="0,5,25,5" />
                        <TextBlock Margin="0,5" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="1"
                                   VerticalAlignment="Center" Opacity="0.5"
                                   Text="请在 启动 → 版本选择 → 文件夹列表 中更改下载目标文件夹。&#xa;在某个文件夹或游戏版本上右键，即可选择打开对应文件夹。" />
                    </Grid>
                </StackPanel>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="社区资源">
                <StackPanel Margin="25,37,25,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="来源" Margin="0,0,25,0" />
                        <c:MyComboBox x:Name="ComboDownloadMod" Grid.Row="0" Grid.ColumnSpan="2"
                                      Grid.Column="1" SelectedIndex="2">
                            <c:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚刚更新的版本）" />
                            <c:MyComboBoxItem Content="仅在官方源加载缓慢时改用镜像源" />
                            <c:MyComboBoxItem Content="尽量使用官方源" />
                        </c:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="文件名格式" Margin="0,0,25,0" />
                        <c:MyComboBox Grid.Row="2" x:Name="ComboDownloadTranslateV2" Grid.ColumnSpan="2"
                                      Grid.Column="1" SelectedIndex="1"
                                      ToolTip.Tip="下载社区资源时，其默认文件名的格式">
                            <c:MyComboBoxItem Content="【机械动力】create-1.21.1-6.0.4" />
                            <c:MyComboBoxItem Content="[机械动力] create-1.21.1-6.0.4" />
                            <c:MyComboBoxItem Content="机械动力-create-1.21.1-6.0.4" />
                            <c:MyComboBoxItem Content="create-1.21.1-6.0.4-机械动力" />
                            <c:MyComboBoxItem Content="create-1.21.1-6.0.4" />
                        </c:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="Mod 管理样式" Margin="0,0,25,0" />
                        <c:MyComboBox Grid.Row="4" x:Name="ComboModLocalNameStyle" Grid.ColumnSpan="2"
                                      Grid.Column="1" SelectedIndex="0"
                                      ToolTip.Tip="在 Mod 管理页面中，Mod 项的显示方式">
                            <c:MyComboBoxItem Content="标题显示译名，详情显示文件名" />
                            <c:MyComboBoxItem Content="标题显示文件名，详情显示译名" />
                        </c:MyComboBox>
                    </Grid>
                </StackPanel>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="辅助功能">
                <Grid Margin="25,40,25,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="游戏更新提示" Margin="0,0,25,0" />
                    <c:MyCheckBox Text="正式版更新提示" Grid.Column="1" x:Name="CheckUpdateRelease"
                                  ToolTip.Tip="在 Minecraft 正式版更新时弹窗提示" />
                    <c:MyCheckBox Text="测试版更新提示" Grid.Column="2" Height="22"
                                  x:Name="CheckUpdateSnapshot"
                                  ToolTip.Tip="在 Minecraft 测试版（快照、预发布版）更新时弹窗提示" />
                    <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left"
                               Text="游戏语言" Margin="0,0,25,0" />
                    <c:MyCheckBox Text="自动设置为中文" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"
                                  x:Name="CheckHelpChinese" Checked="True" />
                </Grid>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="启动器">
                <Grid Margin="25,40,25,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="启动器更新" Margin="0,0,25,0" />
                    <c:MyComboBox x:Name="ComboSystemUpdate" Grid.Column="1" SelectedIndex="0">
                        <c:MyComboBoxItem x:Name="ItemSystemUpdateDownload"
                                          Content="在有新版本时自动下载（更新非正式版前需要先输入土豆码）" />
                        <c:MyComboBoxItem Content="在有新版本时显示提示" />
                        <c:MyComboBoxItem Content="仅在有重大漏洞更新时显示提示" />
                        <c:MyComboBoxItem Content="关闭更新提示" />
                    </c:MyComboBox>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="启动器公告" Margin="0,0,25,0" Grid.Row="2" />
                    <c:MyComboBox x:Name="ComboSystemActivity" Grid.Column="1" Grid.Row="2"
                                  SelectedIndex="0">
                        <c:MyComboBoxItem Content="显示所有公告"
                                          ToolTip.Tip="显示包括启动器功能调查、活动等在内的全部公告" />
                        <c:MyComboBoxItem Content="仅在有重要通知时显示公告" />
                        <c:MyComboBoxItem Content="关闭所有公告" />
                    </c:MyComboBox>
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="缓存文件夹" Margin="0,0,25,0" />
                    <c:MyTextBox x:Name="TextSystemCache" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="1"
                                 HintText="默认"
                                 ToolTip.Tip="PCL 的下载、皮肤等缓存文件的存储位置。&#xa;不推荐路径中带有空格。&#xa;留空即为默认值，重启 PCL 后生效。" />
                    <Grid Height="35" Grid.Row="7" Grid.ColumnSpan="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <c:MyButton Grid.Column="0" x:Name="BtnSystemUpdate" MinWidth="140"
                                    Text="检查更新" Padding="13,0" Margin="0,0,20,0" />
                        <c:MyButton Grid.Column="1" x:Name="BtnSystemSettingExp" MinWidth="140"
                                    Text="导出设置" Padding="13,0" Margin="0,0,20,0" />
                        <c:MyButton Grid.Column="2" x:Name="BtnSystemSettingImp" MinWidth="140"
                                    Text="导入设置" Padding="13,0" Margin="0,0,20,0" />
                    </Grid>
                    <Grid Height="35" Grid.Row="8" Grid.ColumnSpan="5" Margin="0,12,0,0"
                          x:Name="PanDonate">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <c:MyButton Grid.Column="0" x:Name="BtnSystemIdentify" MinWidth="140"
                                    Text="复制识别码" Padding="13,0" Margin="0,0,20,0" />
                        <c:MyButton Grid.Column="1" x:Name="BtnSystemUnlock" MinWidth="140"
                                    Text="输入土豆码" Padding="13,0" Margin="0,0,20,0" />
                    </Grid>
                </Grid>
            </c:MyCard>

            <!-- 原 XAML 中被注释掉的「全局设置」卡片（PageSetupSystem.xaml L165–L180）不参与渲染，故不移植 -->

            <c:MyCard x:Name="CardDebug" Margin="0,0,0,15" Title="调试选项"
                      CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanDebugAnim" Height="22" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="动画速度" Margin="0,0,25,0" />
                        <c:MySlider x:Name="SliderDebugAnim" MaxValue="30" Value="9" Grid.Column="1" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <c:MyCheckBox Grid.Column="0" Text="禁止在下载时从其他文件夹复制文件" Height="22"
                                      x:Name="CheckDebugSkipCopy"
                                      ToolTip.Tip="在下载时不直接复制其他 MC 文件夹中已经存在的相同文件，而是重新下载文件。&#xa;只建议在测试下载速度时开启。" />
                        <c:MyCheckBox Grid.Column="1" Text="调试模式" Height="22"
                                      x:Name="CheckDebugMode"
                                      ToolTip.Tip="显示调试信息与更多错误信息。&#xa;这会导致启动器性能略有下降，若无特殊需要不建议开启。" />
                        <c:MyCheckBox Grid.Column="2" Text="添加延迟" Height="22"
                                      x:Name="CheckDebugDelay"
                                      ToolTip.Tip="在各个环节添加随机的延迟，拖慢加载速度，以测试部分功能是否正常运行。&#xa;这会严重影响启动器运行，若无特殊需要不建议开启。" />
                    </Grid>
                </StackPanel>
            </c:MyCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
