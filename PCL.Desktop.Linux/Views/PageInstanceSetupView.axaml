<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PCL.Desktop.Linux.Controls"
             x:Class="PCL.Desktop.Linux.Views.PageInstanceSetupView">

    <!--
      1:1 对照基准：pcl-next/Pages/PageInstance/PageInstanceSetup.xaml（276 行）
      外层：MyPageRight PanScroll="PanBack" → MyScrollViewer → StackPanel Margin 25,25,25,25
      四张卡：启动选项 / 内存分配 / 服务器 / 高级选项（折叠）+ 底部「全局设置」按钮。
      差异登记 R48：SettingService 双向绑定（local:SettingService.Key/Value）与 ValidateRules 未接入，
      各输入框只保留 HintText / MaxLength / ToolTip；下拉与单选按 Windows 默认索引呈现
      （本页仅在已选版本时可达，Linux 尚无实例服务，R47）。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,25" Grid.IsSharedSizeScope="True">

            <c:MyHint Text="这些设置只对该游戏版本生效，不影响其他版本。" HintTheme="Blue" Margin="0,0,0,15"
                      CanClose="True" RelativeSetup="HintIndieSetup" />

            <c:MyCard x:Name="CardArgument" Margin="0,0,0,15" Title="启动选项">
                <StackPanel Margin="25,40,25,21">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="版本隔离" Margin="0,0,25,0" />
                        <c:MyComboBox x:Name="ComboArgumentIndieV2" Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="1">
                            <c:MyComboBoxItem Content="开启"
                                              ToolTip.Tip="与其他版本的存档、Mod 等文件相互独立，互不干涉。&#10;这会使你无法跨版本共享存档，但可以规避 Mod 冲突问题。" />
                            <c:MyComboBoxItem Content="关闭"
                                              ToolTip.Tip="与其余关闭隔离的版本共享存档、Mod 等文件。&#10;若存在多个安装了 Mod 的版本，可能会由于 Mod 冲突而导致崩溃。" />
                        </c:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="游戏窗口标题" Margin="0,0,25,0" />
                        <c:MyTextBox x:Name="TextArgumentTitle" Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="1"
                                     ToolTip.Tip="自定义游戏窗口的标题，若留空则跟随全局设置的值。&#10;你可以用替换标记来动态改变其内容，在 更多 → 帮助 中搜索 “替换标记” 以了解用法。"
                                     HintText="跟随全局设置" MaxLength="100" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="自定义信息" Margin="0,0,25,0" />
                        <c:MyTextBox x:Name="TextArgumentInfo" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="1"
                                     HintText="跟随全局设置"
                                     ToolTip.Tip="注意：Mojang 于 Minecraft 26.1 移除了该设置，因此该设置在新版本中无效。&#10;&#10;该信息会显示在游戏主界面的左下角，与 F3 调试页面的左上角。&#10;若留空，则跟随全局设置的值。&#10;&#10;你可以用替换标记来动态改变其内容，在 更多 → 帮助 中搜索 “替换标记” 以了解用法。" />
                        <TextBlock VerticalAlignment="Center" Grid.Row="6" HorizontalAlignment="Left" Text="Java" Margin="0,0,25,0" />
                        <Grid Grid.ColumnSpan="2" Grid.Row="6" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:MyComboBox x:Name="ComboArgumentJava">
                                <c:MyComboBoxItem Content="自动选择"
                                                  ToolTip.Tip="由 PCL Next 自动分析需要的 Java 版本，如果没有合适的 Java 则自动下载。" />
                                <c:MyComboBoxItem Content="自动选择指定版本的 Java"
                                                  ToolTip.Tip="手动输入一个 Java 版本范围，PCL Next 将选择符合该范围的 Java，如果没有合适的 Java 则自动下载。&#10;适合部分 Mod 需要特定 Java 版本才能启动的情况。" />
                                <c:MyComboBoxItem Content="使用版本文件夹中的 Java"
                                                  ToolTip.Tip="手动在当前版本的文件夹中放置 Java 后，PCL Next 将自动搜索并使用该 Java。&#10;适合整合包自带 Java 的情况。" />
                                <c:MyComboBoxItem Content="使用指定的 Java"
                                                  ToolTip.Tip="手动指定所使用的 Java 的绝对路径。&#10;若将该版本打包到其他电脑，此设置可能会失效。" />
                            </c:MyComboBox>
                            <c:MyTextBox x:Name="TextArgumentJavaRange" Grid.Column="1" Margin="7,0,0,0" Width="200"
                                         ToolTip.Tip="输入允许的 Java 版本区间，例如 [17.0.1, 25.0)。&#10;方括号代表包含，圆括号代表不包含。不写其中一侧代表不限制。&#10;&#10;例如：&#10;[21.0, ) 代表至少需要 Java 21。&#10;(, 18.0) 代表允许 Java 17-，但不允许 Java 18+（圆括号代表不包含）。&#10;[8.0.81, 8.0.141] 则代表仅允许 Java 8u81 ~ 8u141。&#10;&#10;你可以在左侧选择 “使用指定的 Java” 来查看你电脑中已有的 Java 的版本号。"
                                         HintText="版本区间…" MaxLength="100" />
                        </Grid>
                        <c:MyHint Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="HintArgumentJava"
                                  Margin="0,8,0,0" IsVisible="False" />
                        <Grid x:Name="PanArgumentJavaSelect" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                              HorizontalAlignment="Stretch" IsVisible="False" Height="28" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:MyComboBox x:Name="ComboArgumentJavaSelect" Grid.Column="0" />
                            <TextBlock x:Name="LabArgumentJava" Grid.Column="0" Margin="8.5,0,21.5,0"
                                       IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <c:MyIconButton Margin="5,2,0,2" Grid.Column="1" x:Name="BtnArgumentJavaSearch"
                                            Logo="M512.0 838.3c-80.2 0-153.4-29.3-210.2-77.4l75.5-75.5c11.5-11.5 25.8-22.0 25.8-37.0a27.2 27.2 0 0 0-27.1-27.1H104.0c-27.1 0-27.1 23.9-27.1 27.1v271.9a27.1 27.1 0 0 0 27.1 27.1c15.0 0 27.8-16.6 42.5-31.2l77.9-77.9c76.6 67.7 177.1 108.9 287.4 108.9 221.7 0 404.5-166.0 431.2-380.6h-109.8c-25.9 154.2-159.7 271.9-321.3 271.9zM919.9 76.6c-15.0 0-27.8 16.6-42.5 31.3L799.5 185.8c-76.5-67.7-177.1-108.9-287.4-108.9-221.8 0-404.5 166.1-431.3 380.6H190.6c25.9-154.2 159.7-271.9 321.4-271.9 80.2 0 153.4 29.3 210.1 77.4l-75.5 75.5c-11.6 11.5-25.8 22.0-25.8 37.1a27.2 27.2 0 0 0 27.1 27.1h271.9c27.1 0 27.1-23.9 27.1-27.1V103.8a27.1 27.1 0 0 0-27.1-27.1z" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </c:MyCard>

            <c:MyCard Margin="0,0,0,15" Title="内存分配">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <c:MyRadioBox Text="跟随全局设置" Width="110" Checked="True" x:Name="RadioRamType2" Margin="0,0,20,9" />
                        <c:MyRadioBox Grid.Row="1" Text="自动配置" Width="110" x:Name="RadioRamType0" Margin="0,0,20,0"
                                      ToolTip.Tip="根据安装的 Mod 量与电脑剩余内存动态调整为游戏分配的内存" />
                        <c:MyRadioBox Grid.Row="3" Text="自定义" x:Name="RadioRamType1" Margin="0,0,20,0" />
                        <c:MySlider Grid.Row="3" Grid.Column="1" IsEnabled="False" x:Name="SliderRamCustom"
                                    MaxValue="49" Value="13" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,6,30,0" Text="启动游戏前进行内存优化" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" />
                        <c:MyComboBox x:Name="ComboRamOptimize" Margin="10,0,0,0" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="2">
                            <c:MyComboBoxItem Content="跟随全局设置" IsSelected="True" />
                            <c:MyComboBoxItem Content="开启" />
                            <c:MyComboBoxItem Content="关闭" />
                        </c:MyComboBox>
                    </Grid>
                    <Grid x:Name="PanRamDisplay" Margin="0,11,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4.7*" />
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="0.7*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="4" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="RectRamUsed" Grid.Row="1" StrokeThickness="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                                    <GradientStop Color="{DynamicResource ColorObject3}" Offset="0" />
                                    <GradientStop Color="{DynamicResource ColorObject2}" Offset="0.5" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Row="1" StrokeThickness="0" Grid.Column="1" Fill="{DynamicResource ColorBrush3}"
                                   Opacity="0.5" x:Name="RectRamGame" />
                        <Rectangle x:Name="RectRamEmpty" Grid.Row="1" StrokeThickness="0" Grid.Column="2"
                                   Fill="{DynamicResource ColorBrush6}" Opacity="0.7" />
                        <TextBlock x:Name="LabRamUsedTitle" Text="已使用内存" Grid.ColumnSpan="3" Opacity="0.7"
                                   Margin="2,0,0,5" FontSize="11" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LabRamGameTitle" Text="游戏分配" Opacity="0.7" Grid.ColumnSpan="3"
                                   Margin="2,0,0,5" FontSize="11" HorizontalAlignment="Left" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Grid.ColumnSpan="3" Margin="2,3,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="LabRamUsed" Text="4.7 GB" FontSize="16" Foreground="Black" />
                            <TextBlock x:Name="LabRamTotal" Text=" / 7.9 GB" FontSize="16" Foreground="Black" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="LabRamGame" Text="2.5 GB" Grid.ColumnSpan="3"
                                   Margin="2,3,0,0" FontSize="16" Foreground="Black" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </c:MyCard>

            <c:MyCard x:Name="CardServer" Margin="0,0,0,15" Title="服务器">
                <StackPanel Margin="25,42,25,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="登录方式" Margin="0,0,25,0" />
                        <c:MyComboBox x:Name="ComboServerLogin" Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="1">
                            <c:MyComboBoxItem Content="正版登录或离线登录" IsSelected="True" />
                            <c:MyComboBoxItem Content="仅正版登录" />
                            <c:MyComboBoxItem Content="仅离线登录" />
                            <c:MyComboBoxItem Content="第三方登录：统一通行证" />
                            <c:MyComboBoxItem Content="第三方登录：Authlib Injector 或 LittleSkin" />
                        </c:MyComboBox>
                        <TextBlock Name="LabServerNide" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="服务器 ID（必填）" Margin="0,8,25,0" IsVisible="False" />
                        <c:MyTextBox x:Name="TextServerNide" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1"
                                     Margin="0,8,0,0" IsVisible="False" HintText="服主后台 → 集成说明 中提供的服务器 ID" />
                        <TextBlock Name="LabServerAuthServer" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="认证服务器（必填）" Margin="0,8,25,0" IsVisible="False" />
                        <c:MyTextBox x:Name="TextServerAuthServer" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1"
                                     Margin="0,8,0,0" IsVisible="False" HintText="Yggdrasil API 认证服务器的完整地址" />
                        <TextBlock Name="LabServerAuthRegister" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="注册链接" Margin="0,8,25,0" IsVisible="False" />
                        <c:MyTextBox x:Name="TextServerAuthRegister" Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="1"
                                     Margin="0,8,0,0" IsVisible="False" HintText="注册账号的网页地址，如 https://xxxxx.xxx/auth/register" />
                        <TextBlock Name="LabServerAuthName" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="服务器名称" Margin="0,8,25,0" IsVisible="False" />
                        <c:MyTextBox x:Name="TextServerAuthName" Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="1"
                                     Margin="0,8,0,0" IsVisible="False" HintText="显示在登录页面的服务器名称" />
                        <TextBlock VerticalAlignment="Center" Grid.Row="5" HorizontalAlignment="Left" Text="自动进入服务器" Margin="0,0,25,0" />
                        <c:MyTextBox x:Name="TextServerEnter" Grid.ColumnSpan="2" Grid.Row="5" Grid.Column="1"
                                     ToolTip.Tip="在打开 Minecraft 后自动进入某服务器。&#10;用英文冒号间隔 IP 与端口，例如 233.233.233.233:12345。" />
                    </Grid>
                    <Grid Height="35" Name="PanServerNide" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <c:MyButton Grid.Column="0" MinWidth="140" Text="服主后台" Padding="13,0" Margin="0,0,20,0"
                                    HorizontalAlignment="Left" ColorType="Highlight" />
                    </Grid>
                    <c:MyButton x:Name="BtnServerAuthLittle" Height="35" MinWidth="150" Margin="0,12,0,0"
                                Text="设置为 LittleSkin" HorizontalAlignment="Left" ColorType="Highlight" />
                </StackPanel>
            </c:MyCard>

            <c:MyCard x:Name="CardAdvance" Margin="0,0,0,15" Title="高级选项" IsSwapped="True" CanSwap="True">
                <Grid Margin="25,40,25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="31" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Java 虚拟机参数" Margin="0,0,25,0" />
                    <c:MyTextBox x:Name="TextAdvanceJvm" Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="1" MaxLength="4000"
                                 ToolTip.Tip="启动 Minecraft 时使用的额外 JVM 参数，在没有确定把握的情况下请不要尝试修改。&#10;&#10;支持 Minecraft 版本 JSON 中的字符串替换标记，例如 ${library_directory}。&#10;也支持使用 PCL Next 的替换标记，在 更多 → 帮助 中搜索 “替换标记” 以了解用法。&#10;&#10;若留空，则跟随全局设置的值。"
                                 HintText="跟随全局设置" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="0,5" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="游戏参数" Margin="0,0,25,0" />
                    <c:MyTextBox x:Name="TextAdvanceGame" Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="1"
                                 ToolTip.Tip="文本框中的内容将会被直接拼合在启动参数的末尾。&#10;例如，输入 --demo 则会以试玩模式启动游戏。&#10;&#10;支持 Minecraft 版本 JSON 中的字符串替换标记，例如 ${library_directory}。&#10;也支持使用 PCL Next 的替换标记，在 更多 → 帮助 中搜索 “替换标记” 以了解用法。&#10;&#10;若留空，则跟随全局设置的值。"
                                 HintText="跟随全局设置" />
                    <TextBlock VerticalAlignment="Center" Grid.Row="4" HorizontalAlignment="Left" Text="内存管理" Margin="0,0,25,0" />
                    <c:MyComboBox Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="1">
                        <c:MyComboBoxItem Content="跟随全局设置" />
                        <c:MyComboBoxItem Content="尽量使用 ZGC" ToolTip.Tip="在 Java 21+ 使用分代 ZGC，20~15 使用非分代的 ZGC，14- 使用 G1GC。&#10;ZGC 的内存占用比 G1GC 更高，不过在回收内存时不会导致卡顿。&#10;覆盖 “Java 虚拟机参数” 设置中的 GC 相关参数。" />
                        <c:MyComboBoxItem Content="尽量使用分代 ZGC" ToolTip.Tip="在 Java 21+ 使用分代 ZGC，20- 使用 G1GC。&#10;ZGC 的内存占用比 G1GC 更高，不过在回收内存时不会导致卡顿。&#10;覆盖 “Java 虚拟机参数” 设置中的 GC 相关参数。" />
                        <c:MyComboBoxItem Content="标准 G1GC" ToolTip.Tip="总是使用 G1GC，附带 Mojang 官方的优化参数。&#10;G1GC 的内存占用比 ZGC 更低，但在回收内存时会导致突然的卡顿。&#10;覆盖 “Java 虚拟机参数” 设置中的 GC 相关参数。" />
                        <c:MyComboBoxItem Content="调优 G1GC" ToolTip.Tip="总是使用 G1GC，附带 PCL Next 调优过的优化参数。&#10;G1GC 的内存占用比 ZGC 更低，但在回收内存时会导致突然的卡顿。&#10;覆盖 “Java 虚拟机参数” 设置中的 GC 相关参数。" />
                        <c:MyComboBoxItem Content="不指定（可自定义）" ToolTip.Tip="不自动添加 GC 参数。&#10;仅当选择此项时，你可以在 “Java 虚拟机参数” 设置中手动添加 GC 参数。" />
                    </c:MyComboBox>
                    <TextBlock Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Left" Text="启动前执行命令" Margin="0,0,25,3" />
                    <c:MyTextBox x:Name="TextAdvanceRun" Grid.Row="6" Grid.ColumnSpan="2" Grid.Column="1" HintText="" Margin="0,0,0,3"
                                 ToolTip.Tip="该项不会覆盖全局设置：启动时会先执行全局设置的命令，再执行版本设置的命令。&#10;&#10;在 MC 启动前执行特定命令或程序，语法与 Windows 的命令提示符一致。&#10;&#10;你可以用替换标记来动态改变其内容或实现相对路径，在 更多 → 帮助 中搜索 “替换标记” 以了解用法。例如：&#10; · &quot;{verpath}test.exe&quot; ：运行版本文件夹下的 test.exe 程序&#10; · &quot;{java}java.exe&quot; -jar &quot;{verpath}test.jar&quot; ：用 Java 运行版本文件夹下的 test.jar&#10; · notepad &quot;{verindie}options.txt&quot; ：使用记事本打开该版本的设置文件&#10;&#10;涉及路径的操作最好都打上双引号，以避免路径中的空格导致运行失败。&#10;执行命令时，命令行所在的目录是当前的 .minecraft 文件夹。" />
                    <c:MyCheckBox Grid.Row="7" Grid.Column="1" x:Name="CheckAdvanceRunWait" IsVisible="False"
                                  Text="等待命令执行完成后再继续启动" Margin="0,5,0,0" />
                    <StackPanel Margin="0,12,0,4" Grid.Row="8" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                        <c:MyCheckBox Height="28" Text="禁止更新 Mod" x:Name="CheckAdvanceDisableModUpdate"
                                      ToolTip.Tip="禁止为此版本更新 Mod，以防止整合包玩家误操作" />
                        <c:MyCheckBox Height="28" Text="关闭文件校验" x:Name="CheckAdvanceAssetsV2"
                                      ToolTip.Tip="完全不更改 assets；不校验 libraries、第三方登录库与版本主 jar 文件是否被修改。&#10;如果你没有修改相关文件，请勿勾选此项。" />
                        <c:MyCheckBox Height="28" Text="禁用 Java Launch Wrapper" x:Name="CheckAdvanceDisableJLW"
                                      ToolTip.Tip="是否使用 Java Launch Wrapper 修复 Java 18- 在中文路径下可能无法正常启动的问题。&#10;详见：https://github.com/00ll00/java_launch_wrapper" />
                        <c:MyCheckBox Height="28" Text="禁用 LWJGL Unsafe Agent" x:Name="CheckAdvanceDisableLUA"
                                      ToolTip.Tip="是否使用 LWJGL Unsafe Agent 修复 LWJGL 3.4.1 的一个性能问题。&#10;详见：https://github.com/HMCL-dev/lwjgl-unsafe-agent" />
                    </StackPanel>
                </Grid>
            </c:MyCard>

            <c:MyExtraTextButton HorizontalAlignment="Center" Margin="0,-5,0,0"
                                 x:Name="BtnSwitch" Text="全局设置" LogoScale="0.9"
                                 Logo="M73 584L920 584 608 896C579 925 579 972 608 1001 637 1030 683 1030 712 1001L1149 565C1164 550 1170 531 1170 511 1170 492 1164 472 1149 457L712 21C683-7 637-7 608 21 579 50 579 97 608 126L920 438 73 438C33 438 0 471 0 511 0 551 33 584 73 584Z" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
