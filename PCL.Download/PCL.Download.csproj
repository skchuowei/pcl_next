<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PCL.Download</RootNamespace>
    <Configurations>Debug;Release;Snapshot</Configurations>
    <Deterministic>true</Deterministic>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      架构护栏（Directory.Build.props §3）：本工程属「无 GUI 内核」，引用闭包内
      不得出现 WPF/WinForms 与 pcl-next/PCLCS/MeloongCore。CI 构建即校验。
    -->
    <PclIsGuiFree>true</PclIsGuiFree>
  </PropertyGroup>

  <!-- 纯 BCL 实现，不引入任何第三方依赖；宿主通过 DI/选项注入日志与策略 -->
  <ItemGroup>
    <!--
      仅向测试工程开放 internal：分块区间账本（Chunk.RangeEnd）与按偏移合并（MergeByOffset）
      是「下载后文件比 FileSize 长」这一缺陷的唯一可确定性回归入口，
      走 public API 只能靠慢速源碰运气复现，无法钉住具体区间。
    -->
    <InternalsVisibleTo Include="PCL.Download.Tests" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);SNAPSHOT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Snapshot|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

</Project>
