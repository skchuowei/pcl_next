#!/bin/sh
# 提交成功后刷新「构建小版本」缓存（《分支与发布规范》§5.2.1）。
#
# 为什么需要这个钩子：
#   产物目录名带构建号（bin-net10\<代号>\<版本>-<构建号>\<RID>\），而 MSBuild 的
#   属性求值发生在所有 Target 之前，那个阶段**不能执行 git 命令**，提交数算不出来。
#   所以由本钩子在提交完成后立即把编号落到 pcl-next/obj/pcl-build.small，
#   供 Directory.Build.props 在求值期直接读文件。
#   没有它，提交后第一次在 IDE 里直接编译会沿用上一次的编号（目录名少一版）。
#
# 这里用纯 sh 计算而不是调用 PowerShell：钩子每次提交都跑，PowerShell 启动开销
# 与 sh 相差一个数量级；且算法与 Get-BuildSmallVersion.ps1 完全同源，不会漂。
# 2026-11-08 三仓库架构裁决后，固定锚点 85c17f13 在新历史里不可达，
# 退化分支改用 scripts/build-number.base 的继承基数（Windows 65 / Linux 71 / Android 60）：
#   编号 = base + max(0, rev-list --count HEAD - 1) + 本机编译次数（2026-11-14 起加编译次数）
# 与 prepare-commit-msg 追加到本次提交信息里的编号一致。
#
# 由 scripts/Install-GitHooks.ps1 安装到 .git/hooks/post-commit。

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
CACHE="$REPO_ROOT/pcl-next/obj/pcl-build.small"

ANCHOR=85c17f13003322a4025e09379bb1ed2d852ea63c
if git rev-parse --verify --quiet "$ANCHOR^{commit}" > /dev/null 2>&1; then
    COUNT=$(git rev-list --count "$ANCHOR..HEAD" 2>/dev/null || echo 0)
else
    BASE=0
    if [ -f "$REPO_ROOT/scripts/build-number.base" ]; then
        RAW=$(tr -d '[:space:]' < "$REPO_ROOT/scripts/build-number.base")
        case "$RAW" in
            ''|*[!0-9]*) BASE=0 ;;
            *) BASE=$RAW ;;
        esac
    fi
    ROOTCOUNT=$(git rev-list --count HEAD 2>/dev/null || echo 0)
    if [ "$ROOTCOUNT" -gt 0 ]; then
        ROOTCOUNT=$((ROOTCOUNT - 1))
    fi
    COUNT=$((BASE + ROOTCOUNT))
fi

# 本机累计编译次数（2026-11-14）：编号 = 提交数 + 编译次数，与编译期脚本同源
SEQ=0
if [ -f "$REPO_ROOT/pcl-next/obj/pcl-build.seq" ]; then
    RAWSEQ=$(tr -d '[:space:]' < "$REPO_ROOT/pcl-next/obj/pcl-build.seq")
    case "$RAWSEQ" in
        ''|*[!0-9]*) SEQ=0 ;;
        *) SEQ=$RAWSEQ ;;
    esac
fi
COUNT=$((COUNT + SEQ))

MAJOR=$((COUNT / 100))
MINOR=$((COUNT % 100))
SMALL=$(printf '%d.%02d' "$MAJOR" "$MINOR")

mkdir -p "$(dirname "$CACHE")" 2>/dev/null

# 内容未变则不重写，避免无谓地刷新文件时间戳
CURRENT=$(cat "$CACHE" 2>/dev/null | tr -d ' \r\n')
if [ "$CURRENT" != "$SMALL" ]; then
    printf '%s\n' "$SMALL" > "$CACHE"
fi

# 钩子永远不阻断提交
exit 0
