#!/bin/sh
# 提交前自动追加「构建小版本」到提交信息末尾（《分支与发布规范》§5.2.1）。
#
# 值 = 自固定锚点以来的提交数 × 0.01，写成 M.mm（与 scripts/Get-BuildSmallVersion.ps1 同源）。
# 锚点是 v2.100.0.1-dev.1 的提交，硬编码且永不移动——用「最近发布标签」会让编号在打新标签后归零，
# 后提交的版本反而比先提交的小。
# 本次提交是第 N+1 个，因此追加的是它自己对应的编号——
# 与编译期脚本在提交后算出的值一致。
#
# 由 scripts/Install-GitHooks.ps1 安装到 .git/hooks/prepare-commit-msg。

MSGFILE="$1"
SOURCE="$2"

# merge / squash 的场景不追加：信息由 git 生成
case "$SOURCE" in
    merge|squash) exit 0 ;;
esac

# amend 场景不追加：$3 是原提交的 SHA，此时编号已经定下，
# 再按 HEAD 算会多加 1（HEAD 仍是那个提交），导致信息里的编号与产物对不上。
if [ -n "$3" ]; then
    exit 0
fi

# 已经带 Build 行就不再重复追加
if grep -q '^Build: ' "$MSGFILE" 2>/dev/null; then
    exit 0
fi

ANCHOR=85c17f13003322a4025e09379bb1ed2d852ea63c

# 独立仓库（2026-11-08 架构裁决）里锚点不可达，退化分支必须叠加继承基数，
# 否则编号会从 0.01 重新起算，比旧线更小，违反「后提交的产物一定更大」。
BASE=0
ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$ROOT" ] && [ -f "$ROOT/scripts/build-number.base" ]; then
    RAW=$(tr -d ' \r\n\t' < "$ROOT/scripts/build-number.base")
    case "$RAW" in
        ''|*[!0-9]*) ;;
        *) BASE=$RAW ;;
    esac
fi

if git rev-parse --verify --quiet "$ANCHOR^{commit}" > /dev/null 2>&1; then
    COUNT=$(git rev-list --count "$ANCHOR..HEAD" 2>/dev/null || echo 0)
    # 本次提交自身的序号
    COUNT=$((COUNT + 1))
else
    # 退化：首个提交继承 BASE，本次提交是 BASE + 已有提交数（与 Get-BuildSmallVersion.ps1 同源）
    TOTAL=$(git rev-list --count HEAD 2>/dev/null || echo 0)
    COUNT=$((BASE + TOTAL))
fi
MAJOR=$((COUNT / 100))
MINOR=$((COUNT % 100))
SMALL=$(printf '%d.%02d' "$MAJOR" "$MINOR")

printf '\nBuild: %s\n' "$SMALL" >> "$MSGFILE"
